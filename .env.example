# Admin bootstrap for db:seed
ADMIN_EMAIL=admin@zapfe.local
ADMIN_PASSWORD=change-me-now

# Mail / Resend SMTP
RESEND_API_KEY=re_xxx
SMTP_ADDRESS=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
MAIL_FROM="Zapfe <info@zapfe.jetzt>"
ADMIN_INBOX_EMAIL=info@zapfe.jetzt
APP_HOST=zapfe.jetzt

# Web Push (generate a VAPID key pair before enabling Push in an environment)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@zapfe.jetzt

# Privacy-friendly, cookieless analytics via self-hosted Umami.
# Keep disabled locally unless you intentionally want local visits in Umami.
UMAMI_ENABLED=false
UMAMI_SCRIPT_URL=https://analytics.duzend.net/script.js
UMAMI_WEBSITE_ID=id
UMAMI_DOMAINS=localhost,127.0.0.1
