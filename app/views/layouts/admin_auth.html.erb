<!DOCTYPE html>
<html lang="de">
  <head>
    <title>Zapfe Admin Login</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="admin-shell flex min-h-screen items-center justify-center px-4">
    <div class="w-full max-w-md rounded-3xl border border-slate-200 bg-white p-8 shadow-sm">
      <div aria-live="polite"><% flash.each do |type, message| %>
        <% tone = type.to_s == "alert" ? "bg-red-100 text-red-800" : "bg-emerald-100 text-emerald-800" %>
        <div class="mb-4 rounded-lg px-4 py-3 text-sm <%= tone %>" role="status"><%= message %></div>
      <% end %></div>
      <%= yield %>
    </div>
  </body>
</html>
