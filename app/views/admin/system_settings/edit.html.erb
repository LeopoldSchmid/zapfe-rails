<div class="admin-toolbar"><div><p class="proof-kicker">Verwaltung</p><h1 class="mt-2 text-3xl font-semibold text-[var(--color-zapfe-navy)]">Einstellungen</h1><p class="mt-1 text-slate-600">Vorgaben für neue Kalkulationen; bereits finalisierte Angebote bleiben unverändert.</p></div></div>
<%= render "shared/form_errors", object: @system_setting %>
<%= form_with model: [ :admin, @system_setting ], url: admin_system_settings_path, method: :patch, class: "mt-6 max-w-2xl rounded-xl border border-slate-200 bg-white p-5" do |f| %><div class="grid gap-4 md:grid-cols-2"><div><%= f.label :standard_tax_rate, "Standard-Umsatzsteuer in %", class: "block text-sm font-medium" %><%= f.number_field :standard_tax_rate, step: 0.01, min: 0, max: 100, required: true, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div><%= f.label :internal_hourly_cost, "Interner Arbeitskostensatz netto pro Stunde", class: "block text-sm font-medium" %><%= f.number_field :internal_hourly_cost, step: 0.01, min: 0, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div></div><%= f.submit "Einstellungen speichern", class: "admin-cta mt-5" %><% end %>
