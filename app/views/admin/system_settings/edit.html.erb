<div class="admin-toolbar"><div><p class="proof-kicker">Verwaltung</p><h1 class="mt-2 text-3xl font-semibold text-[var(--color-zapfe-navy)]">Einstellungen</h1><p class="mt-1 text-slate-600">Vorgaben für neue Kalkulationen und finalisierte Rechnungen. Bereits erstellte Dokumente bleiben unverändert.</p></div></div>
<%= render "shared/form_errors", object: @system_setting %>
<%= form_with model: [ :admin, @system_setting ], url: admin_system_settings_path, method: :patch, class: "mt-6 max-w-3xl rounded-xl border border-slate-200 bg-white p-5" do |f| %>
  <section><h2 class="text-lg font-semibold">Kalkulation</h2><div class="mt-4 grid gap-4 md:grid-cols-2"><div><%= f.label :standard_tax_rate, "Standard-Umsatzsteuer in %", class: "admin-field-label" %><%= f.number_field :standard_tax_rate, step: 0.01, min: 0, max: 100, required: true, class: "admin-field" %></div><div><%= f.label :internal_hourly_cost, "Interner Arbeitskostensatz netto pro Stunde", class: "admin-field-label" %><%= f.number_field :internal_hourly_cost, step: 0.01, min: 0, class: "admin-field" %></div></div></section>
  <section class="mt-7 border-t border-slate-200 pt-6"><h2 class="text-lg font-semibold">Rechnungsaussteller und Zahlung</h2><p class="mt-1 text-sm text-slate-600">Diese Angaben werden beim Finalisieren in jede Rechnung kopiert.</p><div class="mt-4 grid gap-4 md:grid-cols-2"><div><%= f.label :company_name, "Firma", class: "admin-field-label" %><%= f.text_field :company_name, class: "admin-field" %></div><div><%= f.label :vat_id, "USt.-ID", class: "admin-field-label" %><%= f.text_field :vat_id, class: "admin-field" %></div><div class="md:col-span-2"><%= f.label :company_address, "Firmenanschrift", class: "admin-field-label" %><%= f.text_area :company_address, rows: 3, class: "admin-field" %></div><div><%= f.label :bank_name, "Bank", class: "admin-field-label" %><%= f.text_field :bank_name, class: "admin-field" %></div><div><%= f.label :iban, "IBAN", class: "admin-field-label" %><%= f.text_field :iban, class: "admin-field" %></div><div><%= f.label :bic, "BIC", class: "admin-field-label" %><%= f.text_field :bic, class: "admin-field" %></div><div><%= f.label :payment_terms_days, "Zahlungsziel in Tagen", class: "admin-field-label" %><%= f.number_field :payment_terms_days, min: 1, required: true, class: "admin-field" %></div></div></section>
  <%= f.submit "Einstellungen speichern", class: "admin-cta mt-6" %>
<% end %>
