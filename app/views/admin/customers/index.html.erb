<div class="admin-toolbar"><div><p class="proof-kicker">Kundenstamm</p><h1 class="mt-2 text-3xl font-semibold text-[var(--color-zapfe-navy)]">Kunden</h1></div><%= link_to "Kunde anlegen", new_admin_customer_path, class: "admin-cta" %></div>
<div class="mt-6 grid gap-4 lg:grid-cols-2"><% @customers.each do |customer| %><article class="admin-panel"><div class="flex items-start justify-between gap-3"><div><h2 class="text-lg font-semibold"><%= customer.name %></h2><p class="mt-1 text-sm text-slate-500"><%= pluralize(customer.orders.count, "Auftrag", "Aufträge") %></p></div><%= link_to "Bearbeiten", edit_admin_customer_path(customer), class: "admin-secondary-action" %></div><ul class="mt-4 space-y-2"><% customer.contacts.each do |contact| %><li class="rounded-xl bg-slate-50 px-3 py-2 text-sm"><strong><%= contact.name %></strong><%= " · #{contact.role}" if contact.role.present? %><%= " · Standard" if contact.primary? %><span class="block text-slate-600"><%= [contact.email, contact.phone].compact_blank.join(" · ") %></span></li><% end %></ul></article><% end %></div>
<%= render "admin/shared/pagination" %>
