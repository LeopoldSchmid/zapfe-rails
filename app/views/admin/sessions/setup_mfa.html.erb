<p class="proof-kicker">Pflichtschritt</p>
<h1 class="mb-2 mt-2 text-2xl font-semibold text-slate-900">MFA einrichten</h1>
<p class="mb-4 text-sm text-slate-600">Füge das Konto in einer TOTP-kompatiblen Authenticator-App hinzu. Ohne erfolgreiche Einrichtung wird kein Adminzugriff freigeschaltet.</p>

<div class="mb-5 rounded-xl bg-slate-100 p-4">
  <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Manueller Schlüssel</p>
  <code class="mt-2 block break-all text-sm font-semibold"><%= @mfa_secret %></code>
  <details class="mt-3 text-xs text-slate-600"><summary class="cursor-pointer font-medium">Provisioning-URI anzeigen</summary><code class="mt-2 block break-all"><%= @provisioning_uri %></code></details>
</div>

<%= form_with url: admin_login_mfa_setup_path, class: "space-y-4" do |f| %>
  <div>
    <%= f.label :code, "Sechsstelliger Code zur Bestätigung", class: "mb-1 block text-sm font-medium" %>
    <%= f.text_field :code, required: true, autocomplete: "one-time-code", inputmode: "numeric", pattern: "[0-9]{6}", autofocus: true, class: "w-full rounded-md border border-slate-300 px-3 py-2" %>
  </div>
  <%= f.submit "MFA aktivieren", class: "admin-cta w-full" %>
<% end %>
