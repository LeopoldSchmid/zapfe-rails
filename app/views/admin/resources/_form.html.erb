<%= render "shared/form_errors", object: @resource %>
<%= form_with model: [ :admin, @resource ], class: "max-w-2xl space-y-5 rounded-xl border border-slate-200 bg-white p-5" do |f| %><div class="grid gap-4 md:grid-cols-2"><div><%= f.label :name, "Name", class: "block text-sm font-medium" %><%= f.text_field :name, placeholder: "Ape #1", required: true, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div><%= f.label :resource_type, "Typ", class: "block text-sm font-medium" %><%= f.text_field :resource_type, placeholder: "Ape", required: true, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div></div><fieldset class="border-t border-slate-200 pt-5"><legend class="font-semibold">Wiederverwendbare Angebotsposition</legend><p class="mt-1 text-sm text-slate-600">Wird beim Erstellen eines Angebots als Mietposition vorgeschlagen.</p><div class="mt-4 grid gap-4 md:grid-cols-3"><div><%= f.label :rental_position_name, "Positionsbezeichnung", class: "block text-sm font-medium" %><%= f.text_field :rental_position_name, placeholder: "Miete Zapfe", class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div><%= f.label :rental_net_price, "Netto-Mietpreis", class: "block text-sm font-medium" %><%= f.number_field :rental_net_price, step: 0.01, min: 0, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div><%= f.label :rental_unit, "Einheit", class: "block text-sm font-medium" %><%= f.text_field :rental_unit, placeholder: "Tag", class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div></div></fieldset><div><%= f.label :configuration_notes, "Konfigurationsnotiz", class: "block text-sm font-medium" %><%= f.text_area :configuration_notes, rows: 3, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><label class="inline-flex items-center gap-2 text-sm"><%= f.check_box :active %> Ressource aktiv und reservierbar</label><div><%= f.submit class: "admin-cta" %></div><% end %>
