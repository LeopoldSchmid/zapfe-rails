<div class="admin-toolbar"><div><p class="proof-kicker">Operativer Bestand</p><h1 class="mt-2 text-3xl font-semibold text-[var(--color-zapfe-navy)]">Ressourcen</h1><p class="mt-1 text-slate-600">Konkrete Einheiten wie Ape #1 oder Kegerator #1.</p></div><%= link_to "Ressource anlegen", new_admin_resource_path, class: "admin-cta" %></div>
<div class="mt-6 space-y-4"><% @resources.each do |resource| %><article class="rounded-xl border border-slate-200 bg-white p-5"><div class="flex flex-col justify-between gap-3 md:flex-row"><div><div class="flex items-center gap-2"><h2 class="font-semibold"><%= resource.name %></h2><span class="rounded-full bg-slate-100 px-2 py-1 text-xs font-semibold text-slate-700"><%= resource.resource_type %></span><% unless resource.active? %><span class="rounded-full bg-rose-100 px-2 py-1 text-xs font-semibold text-rose-700">Inaktiv</span><% end %></div><p class="mt-2 text-sm text-slate-600"><%= resource.configuration_notes.presence || "Keine Konfigurationsnotiz" %></p></div><%= link_to "Bearbeiten", edit_admin_resource_path(resource), class: "admin-cta" %></div><% upcoming = @upcoming_reservations_by_resource.fetch(resource.id, []) %><% if upcoming.any? %><div class="mt-4 border-t border-slate-100 pt-3 text-sm"><p class="font-medium">Nächste Belegungen</p><ul class="mt-2 space-y-1 text-slate-600"><% upcoming.each do |reservation| %><li><%= l(reservation.starts_at, format: :short) %>–<%= l(reservation.ends_at, format: :short) %> · <%= link_to reservation.order.customer_name, admin_order_path(reservation.order), class: "underline" %></li><% end %></ul></div><% end %></article><% end %></div>
<section class="mt-6 rounded-xl border border-slate-200 bg-white p-5"><div class="flex flex-wrap items-center justify-between gap-3"><div><h2 class="font-semibold">Belegungskalender</h2><p class="mt-1 text-sm text-slate-600">Konkrete Reservierungen der kommenden beziehungsweise gewählten Woche.</p></div><div class="flex gap-2"><%= link_to "← Vorherige Woche", admin_resources_path(week: (@calendar_start - 7.days).iso8601), class: "admin-link" %><%= link_to "Diese Woche", admin_resources_path, class: "admin-link" %><%= link_to "Nächste Woche →", admin_resources_path(week: (@calendar_start + 7.days).iso8601), class: "admin-link" %></div></div><div class="mt-4 overflow-x-auto"><table class="min-w-full border-collapse text-sm"><thead><tr><th class="border border-slate-200 bg-slate-50 p-2 text-left">Ressource</th><% @calendar_days.each do |day| %><th class="min-w-32 border border-slate-200 bg-slate-50 p-2 text-left"><%= l(day, format: :short) %></th><% end %></tr></thead><tbody><% @resources.each do |resource| %><tr><th class="border border-slate-200 p-2 text-left align-top"><%= resource.name %></th><% @calendar_days.each do |day| %><% reservations = @calendar_reservations_by_cell.fetch([ resource.id, day ], []) %><td class="border border-slate-200 p-2 align-top"><% if reservations.any? %><% reservations.each do |reservation| %><%= link_to reservation.order.customer_name, admin_order_path(reservation.order), class: "mb-1 block rounded bg-amber-100 px-2 py-1 font-medium text-amber-950" %><% end %><% else %><span class="text-slate-400">Frei</span><% end %></td><% end %></tr><% end %></tbody></table></div></section>
