<div class="admin-toolbar">
  <div>
    <p class="proof-kicker">Übersicht</p>
    <h1 class="mt-2 text-3xl font-semibold text-[var(--color-zapfe-navy)]">Dashboard</h1>
  </div>
  <div class="flex flex-wrap gap-2">
    <%= link_to "Anfragen öffnen", admin_inquiries_path, class: "admin-cta" %>
    <%= link_to "Auftrag anlegen", new_admin_order_path, class: "rounded-xl border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700" %>
    <%= link_to "Produkt anlegen", new_admin_product_path, class: "admin-cta" %>
    <%= link_to "Event anlegen", new_admin_event_path, class: "rounded-xl border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700" %>
  </div>
</div>

<div class="mt-8 grid gap-6 lg:grid-cols-2">
  <section class="rounded-xl border border-amber-300 bg-amber-50 p-5">
    <div class="flex items-center justify-between"><h2 class="font-semibold text-amber-950">Unzugewiesene Anfragen</h2><%= link_to "Alle", admin_inquiries_path(unassigned: 1), class: "text-sm font-semibold text-amber-900" %></div>
    <% if @unassigned_inquiries.any? %><ul class="mt-3 space-y-2"><% @unassigned_inquiries.each do |inquiry| %><li><%= link_to "#{inquiry.customer_name} · #{inquiry.event_date || inquiry.starts_on || 'Termin offen'}", admin_inquiry_path(inquiry), class: "underline" %></li><% end %></ul><% else %><p class="mt-3 text-sm text-amber-900">Keine offenen unzugewiesenen Anfragen.</p><% end %>
  </section>
  <section class="rounded-xl border border-slate-200 bg-white p-5"><h2 class="font-semibold">Nächste Veranstaltungen</h2><% if @upcoming_orders.any? %><ul class="mt-3 space-y-2"><% @upcoming_orders.each do |order| %><li><%= link_to "#{order.event_date} · #{order.customer_name}", admin_order_path(order), class: "underline" %></li><% end %></ul><% else %><p class="mt-3 text-sm text-slate-600">Noch keine anstehenden Aufträge.</p><% end %></section>
</div>

<% if @due_inquiries.any? %><section class="mt-6 rounded-xl border border-rose-200 bg-rose-50 p-5"><h2 class="font-semibold text-rose-950">Fällige nächste Schritte</h2><ul class="mt-3 space-y-2"><% @due_inquiries.each do |inquiry| %><li><%= link_to "#{inquiry.next_step_due_on} · #{inquiry.customer_name}: #{inquiry.next_step}", admin_inquiry_path(inquiry), class: "underline" %></li><% end %></ul></section><% end %>

<% if @waiting_inquiries.any? %><section class="mt-6 rounded-xl border border-sky-200 bg-sky-50 p-5"><h2 class="font-semibold text-sky-950">Wartet auf Rückmeldung</h2><ul class="mt-3 space-y-2"><% @waiting_inquiries.each do |inquiry| %><li><%= link_to "#{inquiry_status_label(inquiry.status)} · #{inquiry.customer_name}", admin_inquiry_path(inquiry), class: "underline" %></li><% end %></ul></section><% end %>

<div class="grid gap-4 md:grid-cols-3">
  <div class="admin-kpi">
    <p class="proof-kicker">Katalog</p>
    <p class="mt-2 text-3xl font-bold text-slate-900"><%= @products_count %></p>
    <p class="mt-1 text-sm text-slate-500">Produkte</p>
  </div>

  <div class="admin-kpi">
    <p class="proof-kicker">Inhalte</p>
    <p class="mt-2 text-3xl font-bold text-slate-900"><%= @events_count %></p>
    <p class="mt-1 text-sm text-slate-500">Events</p>
  </div>

  <div class="admin-kpi">
    <p class="proof-kicker">Eingang</p>
    <p class="mt-2 text-3xl font-bold text-slate-900"><%= @inquiries_count %></p>
    <p class="mt-1 text-sm text-slate-500">Anfragen</p>
  </div>
</div>
