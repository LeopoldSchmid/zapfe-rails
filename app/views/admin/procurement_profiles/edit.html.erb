<div class="admin-toolbar"><div><p class="proof-kicker">Beschaffung</p><h1 class="mt-2 text-3xl font-semibold">Standardprofil: <%= @procurement_profile.name %></h1><p class="mt-2 text-slate-600">Diese Werte gelten als Vorgabe für alle Händlerangebote mit diesem Profil. Einzelne Angebote können sie bei Bedarf überschreiben.</p></div></div>
<%= render "shared/form_errors", object: @procurement_profile %>
<%= form_with model: [ :admin, @procurement_profile ], class: "mt-6 space-y-6" do |f| %>
  <section class="rounded-xl border border-slate-200 bg-white p-5"><div class="grid gap-4 md:grid-cols-3"><div><%= f.label :lead_time_days, "Vorlauf (Tage)", class: "block text-sm font-medium" %><%= f.number_field :lead_time_days, min: 0, required: true, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div><%= f.label :return_policy, "Rückgabe", class: "block text-sm font-medium" %><%= f.select :return_policy, [["Unbekannt", "unknown"], ["Rückgabefähig", "returnable"], ["Nicht rückgabefähig", "non_returnable"]], {}, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div><%= f.label :return_period_days, "Rückgabefrist (Tage)", class: "block text-sm font-medium" %><%= f.number_field :return_period_days, min: 0, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div></div><div class="mt-4"><%= f.label :delivery_notes, "Lieferhinweise", class: "block text-sm font-medium" %><%= f.text_area :delivery_notes, rows: 2, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div class="mt-4"><%= f.label :cancellation_notes, "Storno-/Rückgabehinweise", class: "block text-sm font-medium" %><%= f.text_area :cancellation_notes, rows: 2, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div></section>
  <div class="flex gap-3"><%= f.submit "Standardprofil speichern", class: "admin-cta" %><%= link_to "Abbrechen", admin_suppliers_path, class: "rounded-xl border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700" %></div>
<% end %>
