<%= render "shared/form_errors", object: @order_template %>
<%= form_with model: [ :admin, @order_template ], class: "max-w-4xl space-y-5 rounded-xl border border-slate-200 bg-white p-5" do |f| %>
  <div class="grid gap-4 md:grid-cols-2"><div><%= f.label :name, "Name der Reihe", class: "block text-sm font-medium" %><%= f.text_field :name, required: true, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div><%= f.label :responsible_admin_user_id, "Standardverantwortlich", class: "block text-sm font-medium" %><%= f.collection_select :responsible_admin_user_id, @admin_users, :id, :name, { include_blank: "Beim neuen Auftrag wählen" }, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div><%= f.label :event_type, "Veranstaltungsart", class: "block text-sm font-medium" %><%= f.text_field :event_type, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div><%= f.label :event_location, "Standardort", class: "block text-sm font-medium" %><%= f.text_field :event_location, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div><%= f.label :guests, "Standard-Gästezahl", class: "block text-sm font-medium" %><%= f.number_field :guests, min: 1, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div><%= f.label :tag_names, "Tags (kommagetrennt)", class: "block text-sm font-medium" %><%= f.text_field :tag_names, placeholder: "Golfplatz, wiederkehrend", class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div><%= f.label :start_time, "Standardbeginn", class: "block text-sm font-medium" %><%= german_time_field(f, :start_time, class_name: "mt-1 w-full rounded border border-slate-300 px-3 py-2") %></div><div><%= f.label :end_time, "Standardende", class: "block text-sm font-medium" %><%= german_time_field(f, :end_time, class_name: "mt-1 w-full rounded border border-slate-300 px-3 py-2") %></div></div>
  <div><%= f.label :customer_message, "Standard-Kundennachricht", class: "block text-sm font-medium" %><%= f.text_area :customer_message, rows: 2, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div>
  <div class="grid gap-3 md:grid-cols-2"><label class="inline-flex items-center gap-2 text-sm"><%= f.check_box :active %> Vorlage aktiv</label><label class="inline-flex items-center gap-2 text-sm"><%= f.check_box :skip_offer %> Angebotsphase für diese Reihe überspringen</label></div>
  <fieldset class="border-t border-slate-200 pt-5"><legend class="font-semibold">Ressourcen</legend><div class="mt-3 grid gap-2 md:grid-cols-3"><%= f.collection_check_boxes :resource_ids, @resources, :id, :name do |box| %><label class="inline-flex items-center gap-2 text-sm"><%= box.check_box %> <%= box.text %></label><% end %></div><p class="mt-2 text-sm text-slate-600">Reservierungen werden nur erzeugt, wenn beim neuen Auftrag ein Datum sowie Beginn und Ende vorhanden sind.</p></fieldset>
  <fieldset class="border-t border-slate-200 pt-5" data-controller="checkbox-filter"><legend class="font-semibold">Vorausgewählte Produkte</legend><div class="mt-3"><label class="sr-only" for="template-product-search">Produkte suchen</label><input id="template-product-search" type="search" placeholder="Getränk oder Mietartikel suchen" class="admin-field" data-checkbox-filter-target="query" data-action="input->checkbox-filter#filter" /></div><div class="mt-3 grid max-h-72 gap-2 overflow-y-auto md:grid-cols-2"><%= f.collection_check_boxes :product_variant_ids, @product_variants, :id, ->(variant) { variant.display_label } do |box| %><label class="inline-flex items-center gap-2 text-sm" data-checkbox-filter-target="item" data-search-text="<%= box.text.downcase %>"><%= box.check_box %> <%= box.text %></label><% end %></div><p class="mt-2 hidden text-sm text-slate-500" data-checkbox-filter-target="empty">Keine passenden Produkte.</p></fieldset>
  <fieldset class="border-t border-slate-200 pt-5"><legend class="font-semibold">Checklisten</legend><div class="mt-3 grid gap-2 md:grid-cols-2"><%= f.collection_check_boxes :checklist_template_ids, @checklist_templates, :id, :name do |box| %><label class="inline-flex items-center gap-2 text-sm"><%= box.check_box %> <%= box.text %></label><% end %></div></fieldset>
  <fieldset class="space-y-3 border-t border-slate-200 pt-5" data-controller="nested-template-tasks"><legend class="font-semibold">Vorlagenaufgaben</legend><div class="mt-3 space-y-3" data-nested-template-tasks-target="container"><%= f.fields_for :template_tasks do |task| %><%= render "template_task_fields", task: task %><% end %></div><template data-nested-template-tasks-target="template"><%= f.fields_for :template_tasks, OrderTemplateTask.new, child_index: "NEW_RECORD" do |task| %><%= render "template_task_fields", task: task %><% end %></template><button type="button" class="admin-secondary-action mt-3" data-action="nested-template-tasks#add">Aufgabe hinzufügen</button></fieldset>
  <%= f.submit class: "admin-cta" %>
<% end %>
