<div class="admin-toolbar"><div><p class="proof-kicker">Wiederkehrende Veranstaltungen</p><h1 class="mt-2 text-3xl font-semibold">Auftragsvorlagen</h1><p class="mt-1 text-slate-600">Erzeugen eigenständige Aufträge mit wiederkehrenden Abläufen.</p></div><%= link_to "Vorlage anlegen", new_admin_order_template_path, class: "admin-cta" %></div>
<div class="mt-6 space-y-3"><% @order_templates.each do |template| %><article class="rounded-xl border border-slate-200 bg-white p-5"><div class="flex items-start justify-between gap-4"><div><h2 class="font-semibold"><%= template.name %></h2><p class="mt-1 text-sm text-slate-600"><%= template.event_location.presence || "Ort offen" %> · <%= template.active? ? "Aktiv" : "Inaktiv" %><%= " · Angebotsphase überspringen" if template.skip_offer? %></p><p class="mt-2 text-sm"><%= template.tags.map(&:name).join(", ").presence || "Ohne Tags" %> · <%= pluralize(template.template_tasks.count, "Aufgabe", "Aufgaben") %> · <%= pluralize(template.resources.count, "Ressource", "Ressourcen") %></p></div><%= link_to "Bearbeiten", edit_admin_order_template_path(template), class: "admin-link" %></div></article><% end %><% if @order_templates.empty? %><p class="rounded-xl border border-dashed border-slate-300 p-5 text-slate-600">Noch keine Auftragsvorlagen angelegt.</p><% end %></div>
