<div class="admin-toolbar"><div><p class="proof-kicker">Wiederkehrende Veranstaltungen</p><h1 class="mt-2 text-3xl font-semibold">Auftragsvorlagen</h1><p class="mt-1 text-slate-600">Erzeugen eigenständige Aufträge mit wiederkehrenden Abläufen.</p></div><%= link_to "Vorlage anlegen", new_admin_order_template_path, class: "admin-cta" %></div>
<div class="mt-6 space-y-3"><% @order_templates.each do |template| %><article class="rounded-xl border border-slate-200 bg-white p-5"><div class="flex items-start justify-between gap-4"><div><h2 class="font-semibold"><%= template.name %></h2><p class="mt-1 text-sm text-slate-600"><%= template.event_location.presence || "Ort offen" %> · <%= template.active? ? "Aktiv" : "Inaktiv" %><%= " · Angebotsphase überspringen" if template.skip_offer? %></p><p class="mt-2 text-sm"><%= template.tags.map(&:name).join(", ").presence || "Ohne Tags" %> · <%= pluralize(template.template_tasks.count, "Aufgabe", "Aufgaben") %> · <%= pluralize(template.resources.count, "Ressource", "Ressourcen") %></p></div><%= link_to "Bearbeiten", edit_admin_order_template_path(template), class: "admin-link" %></div><details class="mt-4 border-t border-slate-100 pt-4"><summary class="cursor-pointer text-sm font-semibold text-[var(--color-zapfe-navy)]">Veranstaltungsserie erstellen</summary><%= form_with url: create_series_admin_order_template_path(template), scope: :series, class: "mt-4 grid gap-3 sm:grid-cols-3 sm:items-end" do |f| %><div><%= f.label :start_on, "Start ab", class: "admin-field-label" %><%= f.date_field :start_on, value: Date.current, class: "admin-field" %></div><div><%= f.label :weekday, "Wochentag", class: "admin-field-label" %><%= f.select :weekday, [["Montag", 1], ["Dienstag", 2], ["Mittwoch", 3], ["Donnerstag", 4], ["Freitag", 5], ["Samstag", 6], ["Sonntag", 0]], { selected: 1 }, class: "admin-field" %></div><div><%= f.label :occurrences, "Anzahl Termine", class: "admin-field-label" %><%= f.number_field :occurrences, value: 4, min: 1, max: 52, class: "admin-field" %></div><div class="sm:col-span-3 flex justify-end"><%= f.submit "Termine erstellen", class: "admin-cta" %></div><% end %></details></article><% end %><% if @order_templates.empty? %><p class="rounded-xl border border-dashed border-slate-300 p-5 text-slate-600">Noch keine Auftragsvorlagen angelegt.</p><% end %></div>
