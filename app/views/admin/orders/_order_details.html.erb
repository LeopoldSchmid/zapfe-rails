<div class="grid gap-6 xl:grid-cols-2">
  <%= form_with model: [:admin, @order], class: "admin-panel" do |f| %>
    <h2 class="text-xl font-semibold text-[var(--color-zapfe-navy)]">Auftrag planen</h2>
    <div class="mt-5 grid gap-4 sm:grid-cols-2"><div><%= f.label :status, "Status", class: "block text-sm font-medium" %><%= f.select :status, Order::STATUSES.map { |status| [order_status_label(status), status] }, {}, class: "admin-field" %></div><div><%= f.label :responsible_admin_user_id, "Verantwortlich", class: "block text-sm font-medium" %><%= f.collection_select :responsible_admin_user_id, @admin_users, :id, :name, {}, class: "admin-field" %></div><div class="sm:col-span-2"><%= f.label :next_step, "Nächster Schritt", class: "block text-sm font-medium" %><%= f.text_area :next_step, rows: 2, class: "admin-field" %></div><div><%= f.label :next_step_due_on, "Fällig am", class: "block text-sm font-medium" %><%= f.date_field :next_step_due_on, class: "admin-field" %></div></div>
    <h3 class="mt-7 text-base font-semibold">Veranstaltung und Kontakt</h3>
    <div class="mt-4 grid gap-4 sm:grid-cols-2"><div><%= f.label :customer_name, "Name oder Firma", class: "block text-sm font-medium" %><%= f.text_field :customer_name, required: true, class: "admin-field" %></div><div><%= f.label :event_date, "Veranstaltungsdatum", class: "block text-sm font-medium" %><%= f.date_field :event_date, class: "admin-field" %></div><div><%= f.label :event_location, "Veranstaltungsort", class: "block text-sm font-medium" %><%= f.text_field :event_location, required: true, class: "admin-field" %></div><div><%= f.label :customer_email, "E-Mail", class: "block text-sm font-medium" %><%= f.email_field :customer_email, class: "admin-field" %></div><div><%= f.label :customer_phone, "Telefon", class: "block text-sm font-medium" %><%= f.telephone_field :customer_phone, class: "admin-field" %></div><div class="sm:col-span-2"><%= f.label :customer_message, "Kundennachricht", class: "block text-sm font-medium" %><%= f.text_area :customer_message, rows: 3, class: "admin-field" %></div></div>
    <%= f.submit "Auftrag speichern", class: "admin-cta mt-5" %>
  <% end %>
  <div class="space-y-6"><%= render "planning_resources", order: @order, reservations: @reservations, resources: @resources %><%= render "attachments" %></div>
</div>
