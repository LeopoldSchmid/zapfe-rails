<section class="admin-panel">
  <div class="flex flex-wrap items-start justify-between gap-4"><div><h2 class="text-xl font-semibold text-[var(--color-zapfe-navy)]">Angebote erstellen und bearbeiten</h2><p class="mt-1 text-sm text-slate-600">Positionen, Preise und interne Kosten werden im Angebotsentwurf bearbeitet.</p></div><%= button_to "Angebotsentwurf erstellen", admin_order_offers_path(@order), method: :post, class: "admin-cta" %></div>
  <% if @order.offers.any? %><div class="mt-5 divide-y divide-slate-100 rounded-2xl border border-slate-200"><% @order.offers.order(version: :desc).each do |offer| %><%= link_to admin_offer_path(offer), class: "flex flex-wrap items-center justify-between gap-3 px-4 py-4 transition hover:bg-slate-50" do %><div><p class="font-semibold text-[var(--color-zapfe-navy)]"><%= offer.offer_number %> · Version <%= offer.version %></p><p class="mt-1 text-sm text-slate-600"><%= offer.recipient_name %> · gültig bis <%= offer.valid_until ? l(offer.valid_until) : "offen" %></p></div><span class="admin-product-badge <%= 'bg-emerald-100 text-emerald-900' if offer.status == 'accepted' %>"><%= offer.status == "accepted" ? "Angenommen" : offer.status == "sent" ? "Versendet" : "Entwurf" %></span><% end %><% end %></div><% else %><div class="admin-empty-state mt-5">Noch kein Angebot vorhanden. Erstelle den ersten Entwurf, sobald die Leistungen und Mengen grob feststehen.</div><% end %>
</section>
