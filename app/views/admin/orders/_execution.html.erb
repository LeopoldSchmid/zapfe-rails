<div class="grid gap-6 xl:grid-cols-2">
  <section class="admin-panel">
    <div class="flex items-baseline justify-between gap-3">
      <div>
        <p class="proof-kicker">Durchführung</p>
        <h2 class="mt-1 text-xl font-semibold text-[var(--color-zapfe-navy)]">Aufgaben</h2>
      </div>
      <span class="text-sm text-slate-500"><%= pluralize(@tasks.count, "offene Aufgabe", "offene Aufgaben") %></span>
    </div>

    <% if @tasks.any? %>
      <ul class="mt-5 space-y-3">
        <% @tasks.each do |task| %>
          <li id="task-<%= task.id %>" class="scroll-mt-28 rounded-xl border border-slate-200 bg-slate-50 p-4 <%= 'ring-2 ring-violet-300' if params[:task_id].to_s == task.id.to_s %>">
            <%= form_with model: [:admin, @order, task], url: admin_order_task_path(@order, task), method: :patch do |f| %>
              <div class="grid gap-3 sm:grid-cols-[minmax(0,1fr)_auto]">
                <div>
                  <%= f.label :title, "Aufgabe", class: "sr-only" %>
                  <%= f.text_field :title, required: true, class: "w-full bg-transparent font-semibold outline-none" %>
                  <p class="mt-1 text-sm text-slate-600"><%= task.assigned_admin_user&.name || "Unzugewiesen" %> · <%= task.due_on ? l(task.due_on) : "Termin offen" %></p>
                </div>
                <div class="flex flex-wrap content-start gap-2">
                  <span class="admin-task-status admin-task-status-<%= task.status %>"><%= task.status == "done" ? "✓ Erledigt" : task.status == "in_progress" ? "● In Arbeit" : "○ Offen" %></span>
                  <%= f.select :status, [["Offen", "open"], ["In Arbeit", "in_progress"], ["Erledigt", "done"]], {}, class: "admin-field mt-0 min-w-32", data: { controller: "status-autosave", action: "change->status-autosave#change" } %>
                  <%= f.submit "Speichern", class: "admin-secondary-action" %>
                </div>
              </div>
              <div class="mt-3">
                <%= f.label :details, "Hinweis", class: "admin-field-label" %>
                <%= f.text_area :details, rows: 2, placeholder: "Was ist bei dieser Aufgabe zu beachten?", class: "admin-field" %>
              </div>
            <% end %>
            <%= button_to "Entfernen", admin_order_task_path(@order, task), method: :delete, class: "mt-3 text-sm font-semibold text-rose-700" %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="mt-5 text-sm text-slate-600">Noch keine Aufgaben angelegt.</p>
    <% end %>

    <%= form_with model: [:admin, @order, Task.new], url: admin_order_tasks_path(@order), class: "mt-6 border-t border-slate-200 pt-5" do |f| %>
      <h3 class="font-semibold text-slate-800">Neue Aufgabe</h3>
      <div class="mt-3 grid gap-3 sm:grid-cols-2">
        <div><%= f.label :title, "Aufgabe", class: "admin-field-label" %><%= f.text_field :title, required: true, class: "admin-field" %></div>
        <div><%= f.label :assigned_admin_user_id, "Verantwortlich", class: "admin-field-label" %><%= f.collection_select :assigned_admin_user_id, @admin_users, :id, :name, { include_blank: "Unzugewiesen" }, class: "admin-field" %></div>
        <div><%= f.label :due_on, "Fällig am", class: "admin-field-label" %><%= stepped_date_field(f, :due_on) %></div>
        <div><%= f.label :details, "Hinweis", class: "admin-field-label" %><%= f.text_field :details, placeholder: "Optionaler Kontext", class: "admin-field" %></div>
      </div>
      <%= f.submit "Aufgabe anlegen", class: "admin-cta mt-4" %>
    <% end %>
  </section>

  <section class="admin-panel">
    <h2 class="text-xl font-semibold text-[var(--color-zapfe-navy)]">Ist-Zeit erfassen</h2>
    <div class="mt-4 grid grid-cols-2 gap-3">
      <div class="rounded-xl bg-slate-50 p-3"><p class="text-sm">Geplant</p><p class="mt-1 text-xl font-semibold"><%= number_to_currency(@order.offers.sum(&:planned_time_cost_total), unit: "€", format: "%n %u") %></p></div>
      <div class="rounded-xl bg-slate-50 p-3"><p class="text-sm">Tatsächlich</p><p class="mt-1 text-xl font-semibold"><%= number_to_currency(@actual_time_entries.sum(&:cost_total), unit: "€", format: "%n %u") %></p></div>
    </div>
    <% if @actual_time_entries.any? %>
      <ul class="mt-4 space-y-2 text-sm"><% @actual_time_entries.each do |entry| %><li class="flex items-center justify-between gap-3"><span><%= entry.category == "organisation" ? "Organisation" : "Durchführung" %> · <%= entry.minutes %> Min. · <%= l(entry.recorded_on) %></span><%= button_to "Entfernen", admin_order_actual_time_entry_path(@order, entry), method: :delete, class: "text-sm font-semibold text-rose-700" %></li><% end %></ul>
    <% end %>
    <%= form_with model: [:admin, @order, TimeEntry.new], url: admin_order_actual_time_entries_path(@order), class: "mt-5 grid gap-3 sm:grid-cols-2" do |f| %>
      <div><%= f.label :category, "Bereich", class: "admin-field-label" %><%= f.select :category, [["Organisation", "organisation"], ["Durchführung", "execution"]], {}, class: "admin-field" %></div>
      <div><%= f.label :minutes, "Minuten", class: "admin-field-label" %><%= f.number_field :minutes, min: 1, required: true, class: "admin-field" %></div>
      <div><%= f.label :recorded_on, "Datum", class: "admin-field-label" %><%= stepped_date_field(f, :recorded_on) %></div>
      <div><%= f.label :note, "Notiz", class: "admin-field-label" %><%= f.text_field :note, class: "admin-field" %></div>
      <div><%= f.submit "Ist-Zeit speichern", class: "admin-cta" %></div>
    <% end %>
  </section>
</div>

<section class="admin-panel mt-6">
  <h2 class="text-xl font-semibold text-[var(--color-zapfe-navy)]">Arbeitschecklisten</h2>
  <% if @checklist_templates.any? %><%= form_with url: admin_order_checklists_path(@order), class: "mt-4 flex flex-wrap items-end gap-3" do |f| %><div><%= f.label :checklist_template_id, "Vorlage", class: "admin-field-label" %><%= f.collection_select :checklist_template_id, @checklist_templates, :id, :name, { include_blank: "Bitte wählen" }, required: true, class: "admin-field" %></div><%= f.submit "Checkliste hinzufügen", class: "admin-secondary-action" %><% end %><% end %>
  <% @checklists.each do |checklist| %><article class="mt-4 rounded-xl bg-slate-50 p-4"><h3 class="font-semibold"><%= checklist.name %></h3><ul class="mt-3 space-y-2"><% checklist.items.order(:position, :id).each do |item| %><li><%= form_with model: [:admin, @order, checklist, item], url: admin_order_checklist_item_path(@order, checklist, item), method: :patch, class: "flex items-start gap-3" do |f| %><%= f.check_box :completed, class: "mt-1", data: { controller: "status-autosave", action: "change->status-autosave#change" } %><div class="flex-1"><strong class="<%= 'line-through text-slate-500' if item.completed? %>"><%= item.title %></strong><% if item.instructions.present? %><p class="text-sm text-slate-600"><%= item.instructions %></p><% end %></div><% end %></li><% end %></ul></article><% end %>
</section>
