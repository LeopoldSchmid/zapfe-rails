<section class="admin-panel mb-6"><div class="flex flex-wrap items-baseline justify-between gap-3"><div><h2 class="text-xl font-semibold text-[var(--color-zapfe-navy)]">Ressourcen planen</h2><p class="mt-1 text-sm text-slate-600">Anfragen blockieren noch nicht. Erst „Reserviert“ blockiert eine Ressource verbindlich.</p></div><div class="flex gap-2 text-xs"><span class="rounded-full bg-amber-100 px-3 py-1 font-semibold text-amber-900">Angefragt: <%= reservations.count(&:requested?) %></span><span class="rounded-full bg-emerald-100 px-3 py-1 font-semibold text-emerald-900">Reserviert: <%= reservations.count(&:reserved?) %></span></div></div><% if reservations.any? %><div class="mt-4 space-y-2"><% reservations.each do |reservation| %><div class="flex flex-wrap items-center justify-between gap-3 rounded-xl border border-slate-200 px-3 py-3 text-sm"><div><strong><%= reservation.resource.name %></strong> · <%= l(reservation.starts_at, format: :short) %>–<%= l(reservation.ends_at, format: :short) %><%= " · #{reservation.note}" if reservation.note.present? %></div><div class="flex items-center gap-2"><span class="rounded-full px-2 py-1 text-xs font-semibold <%= reservation.reserved? ? "bg-emerald-100 text-emerald-900" : "bg-amber-100 text-amber-900" %>"><%= reservation.reserved? ? "Reserviert" : "Angefragt" %></span><% if reservation.requested? %><%= button_to "Verbindlich reservieren", admin_order_reservation_path(order, reservation), method: :patch, params: { reservation: { status: "reserved" } }, class: "admin-cta" %><% end %><%= button_to "Freigeben", admin_order_reservation_path(order, reservation), method: :delete, class: "text-sm font-semibold text-rose-700" %></div></div><% end %></div><% end %><%= form_with model: [ :admin, order, Reservation.new(status: "requested") ], url: admin_order_reservations_path(order), class: "mt-5 grid gap-3 md:grid-cols-3" do |f| %><div><%= f.label :resource_id, "Ressource", class: "block text-sm font-medium" %><%= f.collection_select :resource_id, resources, :id, :name, { include_blank: "Bitte wählen" }, required: true, class: "mt-1 w-full rounded-xl border border-slate-300 px-3 py-2" %></div><div><%= f.label :starts_at, "Beginn", class: "block text-sm font-medium" %><%= f.datetime_local_field :starts_at, required: true, class: "mt-1 w-full rounded-xl border border-slate-300 px-3 py-2" %></div><div><%= f.label :ends_at, "Ende", class: "block text-sm font-medium" %><%= f.datetime_local_field :ends_at, required: true, class: "mt-1 w-full rounded-xl border border-slate-300 px-3 py-2" %></div><div><%= f.label :status, "Planungsstatus", class: "block text-sm font-medium" %><%= f.select :status, [["Angefragt (blockiert nicht)", "requested"], ["Sofort verbindlich reservieren", "reserved"]], {}, class: "mt-1 w-full rounded-xl border border-slate-300 px-3 py-2" %></div><div class="md:col-span-2"><%= f.label :note, "Interne Notiz", class: "block text-sm font-medium" %><%= f.text_field :note, class: "mt-1 w-full rounded-xl border border-slate-300 px-3 py-2" %></div><div class="md:col-span-3"><%= f.submit "Ressource einplanen", class: "admin-cta" %></div><% end %></section>
