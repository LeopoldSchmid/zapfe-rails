<% offer_status_label = { "draft" => "Entwurf", "finalized" => "Finalisiert", "sent" => "Versendet", "accepted" => "Angenommen" } %>
<% eligible_offers = @order.offers.reject { |offer| offer.status.in?(%w[rejected expired]) } %>

<section class="admin-panel">
  <div><p class="proof-kicker">Beschaffung</p><h2 class="mt-1 text-xl font-semibold text-[var(--color-zapfe-navy)]">Bestellungen vorbereiten und verfolgen</h2></div>

  <% if eligible_offers.empty? %>
    <div class="admin-empty-state mt-5"><p class="font-semibold text-slate-700">Noch kein verwendbares Angebot</p><p class="mt-1">Erstelle in der Angebotsphase zunächst einen Entwurf. Abgelehnte und abgelaufene Angebote sind bewusst ausgeschlossen.</p><%= link_to "Zu den Angeboten", admin_order_offers_path(@order), class: "admin-secondary-action mt-4 inline-flex" %></div>
  <% else %>
    <%= form_with url: admin_order_procurement_plans_path(@order), class: "mt-5 flex flex-wrap items-end gap-3 rounded-2xl bg-slate-50 p-4", data: { controller: "procurement-offer-status" } do |f| %>
      <div><%= f.label :offer_id, "Angebotsgrundlage", class: "block text-sm font-medium" %><%= f.select :offer_id, options_for_select(eligible_offers.map { |offer| ["#{offer.offer_number.presence || "Entwurf v#{offer.version}"} · #{offer_status_label.fetch(offer.status)}#{" · noch nicht angenommen" unless offer.status == "accepted"}", offer.id, { data: { offer_status: offer.status } }] }), {}, class: "admin-field", data: { procurement_offer_status_target: "select", action: "change->procurement-offer-status#update" } %></div>
      <div class="max-w-sm text-sm text-amber-900" data-procurement-offer-status-target="notice"><span class="admin-product-badge bg-amber-100 text-amber-900">Vorläufig</span><p class="mt-1">Dieses Angebot ist noch nicht angenommen.</p></div>
      <%= button_tag type: "submit", class: "admin-cta inline-flex items-center gap-2" do %><%= admin_icon(:plus) %>Beschaffungsplan erstellen<% end %>
    <% end %>
  <% end %>

  <% @procurement_plans.each do |plan| %>
    <article class="mt-5 rounded-2xl border border-slate-200 p-4">
      <%= form_with model: [:admin, @order, plan], url: admin_order_procurement_plan_path(@order, plan), method: :patch, class: "flex flex-wrap items-start justify-between gap-4" do |f| %>
        <div><div class="flex flex-wrap items-center gap-2"><h3 class="font-semibold">Plan vom <%= l(plan.created_at, format: :short) %></h3><% if plan.offer && plan.offer.status != "accepted" %><span class="admin-product-badge bg-amber-100 text-amber-900">Angebot noch nicht angenommen</span><% elsif plan.offer %><span class="admin-product-badge bg-emerald-100 text-emerald-900">Angebot angenommen</span><% end %></div><p class="mt-1 text-sm text-slate-600"><%= plan.offer ? "Grundlage: #{plan.offer.offer_number.presence || "Entwurf v#{plan.offer.version}"}" : "Ohne Angebotsgrundlage" %> · Bestellfrist: <%= plan.order_by_on ? l(plan.order_by_on) : "Termin offen" %></p></div>
        <div><%= f.label :status, "Status", class: "block text-xs font-medium" %><%= f.select :status, [["Geplant", "planned"], ["Angefragt", "requested"], ["Bestätigt", "confirmed"], ["Erledigt", "done"]], {}, class: "admin-field", data: { controller: "status-autosave", action: "change->status-autosave#change" } %></div>
      <% end %>
      <ul class="mt-4 space-y-2 text-sm"><% plan.items.each do |item| %><li class="rounded-xl bg-slate-50 px-3 py-2"><strong><%= item.description %></strong> · <%= item.quantity %> <%= item.unit %><br><span class="text-slate-600"><%= item.supplier_offering&.supplier&.name || "Intern / Bezugsquelle offen" %> · Bestellung bis <%= item.order_by_on ? l(item.order_by_on) : "Termin offen" %><%= " · nicht rückgabefähig" if item.non_returnable? %></span></li><% end %></ul>
      <% suppliers = plan.items.filter_map { |item| item.supplier_offering&.supplier }.uniq %>
      <% if suppliers.any? %><div class="mt-4 space-y-3"><% suppliers.each do |supplier| %><% supplier_items = plan.items.select { |item| item.supplier_offering&.supplier_id == supplier.id } %><details class="admin-order-message" data-controller="order-message"><summary>Bestellung an <%= supplier.name %></summary><div class="admin-order-message-preview" data-order-message-target="source" style="font-family:Arial,sans-serif;font-size:14px;line-height:1.5;color:#1f2937"><p>Guten Tag,</p><p>bitte liefern Sie uns für <strong><%= @order.customer_name %></strong><%= " am #{l(@order.event_date)}" if @order.event_date %> folgende Positionen:</p><table role="presentation" style="border-collapse:collapse;width:100%;max-width:640px;margin:16px 0"><thead><tr><th style="padding:8px 12px;border-bottom:2px solid #334155;text-align:left">Artikel</th><th style="padding:8px 12px;border-bottom:2px solid #334155;text-align:left;white-space:nowrap">Menge</th><th style="padding:8px 12px;border-bottom:2px solid #334155;text-align:left">Hinweis</th></tr></thead><tbody><% supplier_items.each do |item| %><tr><td style="padding:9px 12px;border-bottom:1px solid #dbe3ec"><%= item.description %></td><td style="padding:9px 12px;border-bottom:1px solid #dbe3ec;white-space:nowrap"><%= item.quantity %> <%= item.unit %></td><td style="padding:9px 12px;border-bottom:1px solid #dbe3ec"><%= item.notes %></td></tr><% end %></tbody></table><p>Vielen Dank und viele Grüße<br>Zapfe!</p></div><button type="button" class="admin-secondary-action mt-3 inline-flex items-center gap-2" data-order-message-target="button" data-action="order-message#copy"><%= admin_icon(:copy) %>Bestelltext kopieren</button></details><% end %></div><% end %>
      <div class="mt-4 flex flex-wrap items-center justify-between gap-3"><%= form_with url: add_attachments_admin_order_procurement_plan_path(@order, plan), multipart: true, class: "flex flex-wrap items-center gap-3" do |f| %><%= file_field_tag "procurement_plan[attachments][]", multiple: true, accept: "application/pdf,image/jpeg,image/png,image/webp", class: "text-sm" %><%= button_tag type: "submit", class: "admin-link inline-flex items-center gap-2" do %><%= admin_icon(:plus) %>Bestellanlage hinzufügen<% end %><% end %><%= button_to admin_order_procurement_plan_path(@order, plan), method: :delete, data: { turbo_confirm: "Beschaffungsplan inklusive aller Positionen wirklich löschen?" }, class: "inline-flex items-center gap-2 text-sm font-semibold text-rose-700" do %><%= admin_icon(:trash) %>Beschaffungsplan löschen<% end %></div>
      <% if plan.requires_non_returnable_confirmation? && !plan.non_returnable_confirmed_at? %><%= form_with model: [:admin, @order, plan], url: admin_order_procurement_plan_path(@order, plan), method: :patch, class: "mt-4 rounded-xl bg-amber-50 p-3" do |f| %><%= f.hidden_field :status, value: "confirmed" %><%= hidden_field_tag :confirm_non_returnable, "1" %><p class="text-sm text-amber-900">Enthält nicht rückgabefähige Positionen.</p><%= f.submit "Nicht rückgabefähige Bestellung bestätigen", class: "admin-secondary-action mt-2" %><% end %><% end %>
    </article>
  <% end %>
</section>
