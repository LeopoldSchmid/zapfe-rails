<% offer_status_label = { "draft" => "Entwurf", "finalized" => "Finalisiert", "sent" => "Versendet", "accepted" => "Angenommen" } %>
<% eligible_offers = @order.offers.reject { |offer| offer.status.in?(%w[rejected expired]) } %>

<section class="admin-panel">
  <div><p class="proof-kicker">Beschaffung</p><h2 class="mt-1 text-xl font-semibold text-[var(--color-zapfe-navy)]">Bestellungen vorbereiten und verfolgen</h2></div>

  <% if eligible_offers.empty? %>
    <div class="admin-empty-state mt-5"><p class="font-semibold text-slate-700">Noch kein verwendbares Angebot</p><p class="mt-1">Erstelle in der Angebotsphase zunächst einen Entwurf. Abgelehnte und abgelaufene Angebote sind bewusst ausgeschlossen.</p><%= link_to "Zu den Angeboten", admin_order_offers_path(@order), class: "admin-secondary-action mt-4 inline-flex" %></div>
  <% else %>
    <%= form_with url: admin_order_procurement_plans_path(@order), class: "mt-5 flex flex-wrap items-end gap-3 rounded-2xl bg-amber-50 p-4" do |f| %>
      <div><%= f.label :offer_id, "Angebotsgrundlage", class: "block text-sm font-medium" %><%= f.collection_select :offer_id, eligible_offers, :id, ->(offer) { "#{offer.offer_number.presence || "Entwurf v#{offer.version}"} · #{offer_status_label.fetch(offer.status)}#{" · noch nicht angenommen" unless offer.status == "accepted"}" }, {}, class: "admin-field" %></div>
      <div class="max-w-sm text-sm text-amber-900"><span class="admin-product-badge bg-amber-100 text-amber-900">Vorläufig möglich</span><p class="mt-1">Ein Plan aus einem noch nicht angenommenen Angebot bleibt klar gekennzeichnet.</p></div>
      <%= f.submit "Beschaffungsplan erstellen", class: "admin-cta" %>
    <% end %>
  <% end %>

  <% @procurement_plans.each do |plan| %>
    <article class="mt-5 rounded-2xl border border-slate-200 p-4">
      <%= form_with model: [:admin, @order, plan], url: admin_order_procurement_plan_path(@order, plan), method: :patch, class: "flex flex-wrap items-start justify-between gap-4" do |f| %>
        <div><div class="flex flex-wrap items-center gap-2"><h3 class="font-semibold">Plan vom <%= l(plan.created_at, format: :short) %></h3><% if plan.offer && plan.offer.status != "accepted" %><span class="admin-product-badge bg-amber-100 text-amber-900">Angebot noch nicht angenommen</span><% elsif plan.offer %><span class="admin-product-badge bg-emerald-100 text-emerald-900">Angebot angenommen</span><% end %></div><p class="mt-1 text-sm text-slate-600"><%= plan.offer ? "Grundlage: #{plan.offer.offer_number.presence || "Entwurf v#{plan.offer.version}"}" : "Ohne Angebotsgrundlage" %> · Bestellfrist: <%= plan.order_by_on ? l(plan.order_by_on) : "Termin offen" %></p></div>
        <div class="flex items-end gap-2"><div><%= f.label :status, "Status", class: "block text-xs font-medium" %><%= f.select :status, [["Geplant", "planned"], ["Angefragt", "requested"], ["Bestätigt", "confirmed"], ["Erledigt", "done"]], {}, class: "admin-field" %></div><%= f.submit "Speichern", class: "admin-secondary-action" %></div>
      <% end %>
      <ul class="mt-4 space-y-2 text-sm"><% plan.items.each do |item| %><li class="rounded-xl bg-slate-50 px-3 py-2"><strong><%= item.description %></strong> · <%= item.quantity %> <%= item.unit %><br><span class="text-slate-600"><%= item.supplier_offering&.supplier&.name || "Bezugsquelle offen" %> · Bestellung bis <%= item.order_by_on ? l(item.order_by_on) : "Termin offen" %><%= " · nicht rückgabefähig" if item.non_returnable? %></span></li><% end %></ul>
      <div class="mt-4 flex flex-wrap items-center justify-between gap-3"><%= form_with url: add_attachments_admin_order_procurement_plan_path(@order, plan), multipart: true, class: "flex flex-wrap items-center gap-3" do |f| %><%= file_field_tag "procurement_plan[attachments][]", multiple: true, accept: "application/pdf,image/jpeg,image/png,image/webp", class: "text-sm" %><%= f.submit "Bestellanlage hinzufügen", class: "admin-link" %><% end %><%= button_to "Beschaffungsplan löschen", admin_order_procurement_plan_path(@order, plan), method: :delete, data: { turbo_confirm: "Beschaffungsplan inklusive aller Positionen wirklich löschen?" }, class: "text-sm font-semibold text-rose-700" %></div>
      <% if plan.requires_non_returnable_confirmation? && !plan.non_returnable_confirmed_at? %><%= form_with model: [:admin, @order, plan], url: admin_order_procurement_plan_path(@order, plan), method: :patch, class: "mt-4 rounded-xl bg-amber-50 p-3" do |f| %><%= f.hidden_field :status, value: "confirmed" %><%= hidden_field_tag :confirm_non_returnable, "1" %><p class="text-sm text-amber-900">Enthält nicht rückgabefähige Positionen.</p><%= f.submit "Nicht rückgabefähige Bestellung bestätigen", class: "admin-secondary-action mt-2" %><% end %><% end %>
    </article>
  <% end %>
</section>
