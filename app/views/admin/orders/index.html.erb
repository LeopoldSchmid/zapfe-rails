<div class="admin-toolbar"><div><p class="proof-kicker">Auftragszentrale</p><h1 class="mt-2 text-3xl font-semibold text-[var(--color-zapfe-navy)]"><%= params[:archived] == "1" ? "Archivierte Aufträge" : "Aufträge" %></h1></div><div class="flex gap-2"><%= link_to(params[:archived] == "1" ? "Aktive Aufträge" : "Archiv", admin_orders_path(params[:archived] == "1" ? {} : { archived: 1 }), class: "rounded-xl border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700") %><%= link_to "Auftrag anlegen", new_admin_order_path, class: "admin-cta" %></div></div>
<div class="space-y-3"><% @orders.each do |order| %><article class="rounded-xl border border-slate-200 bg-white p-4"><div class="flex flex-col justify-between gap-3 md:flex-row"><div><p class="font-semibold"><%= order.customer_name %> <span class="font-normal text-slate-500">· <%= order.event_date || "Termin offen" %></span></p><p class="mt-1 text-sm text-slate-600"><%= order.event_location %> · <%= order_status_label(order.status) %> · <%= order.responsible_admin_user.name %></p><% if order.next_step.present? %><p class="mt-2 text-sm"><strong>Nächster Schritt:</strong> <%= order.next_step %></p><% end %></div><div class="flex gap-2"><%= link_to "Öffnen", admin_order_path(order), class: "admin-cta" %><% if order.archived? %><%= button_to "Wiederherstellen", unarchive_admin_order_path(order), method: :patch, class: "rounded-xl border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700" %><% end %></div></div></article><% end %></div>
