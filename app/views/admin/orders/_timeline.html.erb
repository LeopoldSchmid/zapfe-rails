<section class="admin-panel mb-6"><div><p class="proof-kicker">Gesamter Vorgang</p><h2 class="mt-1 text-xl font-semibold text-[var(--color-zapfe-navy)]">Bearbeitungschronik</h2><p class="mt-1 text-sm text-slate-600">Anfrage, Auftrag, Angebot und Ressourcenplanung in einer zeitlichen Geschichte.</p></div><% if activities.any? %><ol class="mt-5 space-y-3 border-l border-slate-200 pl-4"><% activities.each do |activity| %><li class="relative text-sm before:absolute before:-left-[1.35rem] before:top-1.5 before:h-2 before:w-2 before:rounded-full before:bg-[var(--color-zapfe-amber)]"><p class="font-medium text-slate-800"><%= activity.message %></p><p class="mt-1 text-xs text-slate-500"><%= activity.admin_user.name %> · <%= l(activity.created_at, format: :short) %> · <%= activity.subject_type == "Inquiry" ? "Anfrage" : activity.subject_type == "Offer" ? "Angebot" : "Auftrag" %></p></li><% end %></ol><% else %><p class="mt-4 text-sm text-slate-500">Noch keine Ereignisse vorhanden.</p><% end %></section>
