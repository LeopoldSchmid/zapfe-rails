<%= render "workspace_header", order: @order, section: "Freie Notizen" %>
<div class="mt-6"><%= render "admin/shared/process_nav", order: @order, current_phase: "notes" %></div>

<section class="admin-panel mt-6 max-w-4xl">
  <h2 class="text-xl font-semibold text-[var(--color-zapfe-navy)]">Freie Notizen</h2>

  <%= form_with model: [:admin, @order], url: notes_admin_order_path(@order), method: :patch, class: "mt-6" do |f| %>
    <%= render "admin/shared/rich_text_field", form: f, attribute: :freeform_notes, label: "Freitext" %>
    <div class="mt-4 flex justify-end">
      <%= f.submit "Notizen speichern", class: "admin-cta" %>
    </div>
  <% end %>
</section>
