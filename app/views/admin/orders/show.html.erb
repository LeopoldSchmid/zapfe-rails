<div class="admin-toolbar"><div><p class="proof-kicker">Auftrag</p><h1 class="mt-2 text-3xl font-semibold"><%= @order.customer_name %></h1><p class="mt-1 text-slate-600"><%= @order.event_date %> · <%= @order.event_location %></p></div><%= link_to "Zurück", admin_orders_path, class: "admin-link" %></div>
<% if @order.archived? %><%= button_to "Wiederherstellen", unarchive_admin_order_path(@order), method: :patch, class: "mb-4 rounded-xl border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700" %><% else %><%= button_to "Archivieren", archive_admin_order_path(@order), method: :patch, class: "mb-4 rounded-xl border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700" %><% end %>
<%= form_with model: [ :admin, @order ], class: "grid gap-6 lg:grid-cols-2" do |f| %><section class="rounded-xl border border-slate-200 bg-white p-5"><h2 class="font-semibold">Auftragsstatus</h2><div class="mt-4 space-y-3 text-sm"><div><%= f.label :status, "Status", class: "block font-medium" %><%= f.select :status, Order::STATUSES.map { |status| [order_status_label(status), status] }, {}, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div><%= f.label :responsible_admin_user_id, "Verantwortlich", class: "block font-medium" %><%= f.collection_select :responsible_admin_user_id, @admin_users, :id, :name, {}, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div><%= f.label :next_step, "Nächster Schritt", class: "block font-medium" %><%= f.text_area :next_step, rows: 2, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div><%= f.label :next_step_due_on, "Fällig am", class: "block font-medium" %><%= f.date_field :next_step_due_on, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div></div></section><section class="rounded-xl border border-slate-200 bg-white p-5"><h2 class="font-semibold">Veranstaltung und Kontakt</h2><div class="mt-4 grid gap-3 text-sm"><div><%= f.label :customer_name, "Name oder Firma", class: "block font-medium" %><%= f.text_field :customer_name, required: true, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div><%= f.label :event_date, "Veranstaltungsdatum", class: "block font-medium" %><%= f.date_field :event_date, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div><%= f.label :event_location, "Veranstaltungsort", class: "block font-medium" %><%= f.text_field :event_location, required: true, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div><%= f.label :customer_email, "E-Mail", class: "block font-medium" %><%= f.email_field :customer_email, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div><%= f.label :customer_phone, "Telefon", class: "block font-medium" %><%= f.telephone_field :customer_phone, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div><%= f.label :customer_message, "Kundennachricht", class: "block font-medium" %><%= f.text_area :customer_message, rows: 3, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div></div><% if @order.inquiry %><%= link_to "Ursprungsanfrage öffnen", admin_inquiry_path(@order.inquiry), class: "admin-link mt-4 inline-block" %><% end %></section><div class="lg:col-span-2"><%= f.submit "Auftrag speichern", class: "admin-cta" %></div><% end %>
<section class="mt-6 rounded-xl border border-slate-200 bg-white p-5"><h2 class="font-semibold">Chronik</h2><% if @activities.any? %><ol class="mt-4 space-y-3"><% @activities.each do |activity| %><li class="border-l-2 border-slate-200 pl-3 text-sm"><p class="font-medium"><%= activity.message %></p><p class="text-slate-500"><%= activity.admin_user.name %> · <%= l(activity.created_at, format: :short) %></p></li><% end %></ol><% else %><p class="mt-3 text-sm text-slate-600">Noch keine Aktivitäten.</p><% end %></section>
<%= form_with url: add_note_admin_order_path(@order), class: "mt-3 flex gap-3" do |f| %><%= text_field_tag :note, nil, required: true, placeholder: "Interne Notiz", class: "flex-1 rounded border border-slate-300 px-3 py-2" %><%= f.submit "Notiz speichern", class: "admin-cta" %><% end %>
<section class="mt-6 rounded-xl border border-slate-200 bg-white p-5"><h2 class="font-semibold">Anlagen</h2><%= form_with url: add_attachments_admin_order_path(@order), multipart: true, class: "mt-3 flex flex-wrap gap-3" do |f| %><%= file_field_tag "order[attachments][]", multiple: true, accept: "application/pdf,image/jpeg,image/png,image/webp", class: "text-sm" %><%= f.submit "Hinzufügen", class: "admin-cta" %><% end %><ul class="mt-4 space-y-2 text-sm"><% @order.attachments.each do |attachment| %><li><%= link_to attachment.filename, attachment_admin_order_path(@order, attachment), class: "underline" %></li><% end %></ul></section>
<section class="mt-6 rounded-xl border border-slate-200 bg-white p-5"><div class="flex items-center justify-between gap-4"><div><h2 class="font-semibold">Angebote</h2><p class="mt-1 text-sm text-slate-600">Entwürfe, Versionen und späterer Versand.</p></div><%= button_to "Angebotsentwurf erstellen", admin_order_offers_path(@order), method: :post, class: "admin-cta" %></div><% if @order.offers.any? %><ul class="mt-4 space-y-2 text-sm"><% @order.offers.order(version: :desc).each do |offer| %><li><%= link_to "Entwurf v#{offer.version} · #{offer.recipient_name}", admin_offer_path(offer), class: "underline" %> <span class="text-slate-500">· gültig bis <%= l(offer.valid_until) %></span></li><% end %></ul><% end %></section>
<section class="mt-6 rounded-xl border border-slate-200 bg-white p-5"><h2 class="font-semibold">Ressourcen reservieren</h2><p class="mt-1 text-sm text-slate-600">Doppelbuchungen werden beim Speichern blockiert. Es gibt bewusst keine automatischen Pufferzeiten.</p><% if @reservations.any? %><ul class="mt-4 space-y-2 text-sm"><% @reservations.each do |reservation| %><li class="flex flex-wrap items-center justify-between gap-2 rounded-lg bg-slate-50 px-3 py-2"><span><strong><%= reservation.resource.name %></strong> · <%= l(reservation.starts_at, format: :short) %>–<%= l(reservation.ends_at, format: :short) %><%= " · #{reservation.note}" if reservation.note.present? %></span><%= button_to "Entfernen", admin_order_reservation_path(@order, reservation), method: :delete, class: "font-semibold text-rose-700" %></li><% end %></ul><% end %><%= form_with model: [ :admin, @order, Reservation.new ], url: admin_order_reservations_path(@order), class: "mt-4 grid gap-3 md:grid-cols-2" do |f| %><div><%= f.label :resource_id, "Ressource", class: "block text-sm font-medium" %><%= f.collection_select :resource_id, @resources, :id, :name, { include_blank: "Bitte wählen" }, required: true, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div><%= f.label :offer_id, "Angebot (optional)", class: "block text-sm font-medium" %><%= f.collection_select :offer_id, @order.offers, :id, :offer_number, { include_blank: "Kein Bezug" }, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div><%= f.label :starts_at, "Beginn", class: "block text-sm font-medium" %><%= f.datetime_local_field :starts_at, required: true, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div><%= f.label :ends_at, "Ende", class: "block text-sm font-medium" %><%= f.datetime_local_field :ends_at, required: true, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div><%= f.label :note, "Interne Notiz", class: "block text-sm font-medium" %><%= f.text_field :note, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div class="self-end"><%= f.submit "Reservieren", class: "admin-cta" %></div><% end %></section>
<section class="mt-6 rounded-xl border border-slate-200 bg-white p-5"><h2 class="font-semibold">Aufgaben</h2><p class="mt-1 text-sm text-slate-600">Fälligkeiten können manuell gesetzt oder relativ zum Veranstaltungsdatum berechnet werden.</p><% if @tasks.any? %><ul class="mt-4 space-y-2 text-sm"><% @tasks.each do |task| %><li class="rounded-lg bg-slate-50 px-3 py-3"><%= form_with model: [ :admin, @order, task ], url: admin_order_task_path(@order, task), method: :patch, class: "grid gap-2 md:grid-cols-[1fr_auto_auto_auto]" do |f| %><div><strong><%= task.title %></strong><span class="ml-2 text-slate-500"><%= task.assigned_admin_user&.name || "Unzugewiesen" %> · <%= task.due_on ? l(task.due_on) : "Termin offen" %></span></div><%= f.select :status, [["Offen", "open"], ["In Arbeit", "in_progress"], ["Erledigt", "done"]], {}, class: "rounded border border-slate-300 px-2 py-1" %><%= f.submit "Speichern", class: "font-semibold text-slate-700" %><%= button_to "Entfernen", admin_order_task_path(@order, task), method: :delete, class: "font-semibold text-rose-700" %><% end %></li><% end %></ul><% end %><%= form_with model: [ :admin, @order, Task.new ], url: admin_order_tasks_path(@order), class: "mt-4 grid gap-3 md:grid-cols-2" do |f| %><div><%= f.label :title, "Aufgabe", class: "block text-sm font-medium" %><%= f.text_field :title, required: true, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div><%= f.label :assigned_admin_user_id, "Verantwortlich", class: "block text-sm font-medium" %><%= f.collection_select :assigned_admin_user_id, @admin_users, :id, :name, { include_blank: "Unzugewiesen" }, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div><%= f.label :due_on, "Manuell fällig am", class: "block text-sm font-medium" %><%= f.date_field :due_on, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div><%= f.label :relative_offset_days, "Oder relativ zum Termin (Tage; negativ = vorher)", class: "block text-sm font-medium" %><%= f.number_field :relative_offset_days, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %><%= f.hidden_field :relative_anchor, value: "event_date" %></div><div class="md:col-span-2"><%= f.label :details, "Hinweis", class: "block text-sm font-medium" %><%= f.text_field :details, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div><%= f.submit "Aufgabe anlegen", class: "admin-cta" %></div><% end %></section>
<section class="mt-6 rounded-xl border border-slate-200 bg-white p-5"><h2 class="font-semibold">Beschaffung</h2><p class="mt-1 text-sm text-slate-600">Die Quelle wird aus dem angenommenen Angebot übernommen, aber erst hier verbindlich bearbeitet.</p><% accepted_offers = @order.offers.where(status: "accepted") %><% if accepted_offers.any? %><%= form_with url: admin_order_procurement_plans_path(@order), class: "mt-4 flex flex-wrap items-end gap-3" do |f| %><div><%= f.label :offer_id, "Angenommenes Angebot", class: "block text-sm font-medium" %><%= f.collection_select :offer_id, accepted_offers, :id, :offer_number, {}, class: "mt-1 rounded border border-slate-300 px-3 py-2" %></div><%= f.submit "Beschaffungsplan erstellen", class: "admin-cta" %><% end %><% end %><% @procurement_plans.each do |plan| %><div class="mt-4 rounded-lg bg-slate-50 p-4"><%= form_with model: [ :admin, @order, plan ], url: admin_order_procurement_plan_path(@order, plan), method: :patch, class: "flex flex-wrap items-center justify-between gap-3" do |f| %><div><p class="font-medium">Plan vom <%= l(plan.created_at, format: :short) %></p><p class="text-sm text-slate-600">Bestellfrist: <%= plan.order_by_on ? l(plan.order_by_on) : "Termin offen" %></p></div><div class="flex items-center gap-2"><%= f.select :status, [["Geplant", "planned"], ["Angefragt", "requested"], ["Bestätigt", "confirmed"], ["Erledigt", "done"]], {}, class: "rounded border border-slate-300 px-2 py-1" %><%= f.submit "Speichern", class: "font-semibold text-slate-700" %></div><% end %><ul class="mt-3 space-y-2 text-sm"><% plan.items.each do |item| %><li><strong><%= item.description %></strong> · <%= item.quantity %> <%= item.unit %> · <%= item.supplier_offering&.supplier&.name || "Quelle offen" %> · Bestellung bis <%= item.order_by_on ? l(item.order_by_on) : "Termin offen" %><%= " · nicht rückgabefähig" if item.non_returnable? %></li><% end %></ul></div><% end %></section>
<section class="mt-6 rounded-xl border border-slate-200 bg-white p-5"><h2 class="font-semibold">Arbeitszeit: Plan und Ist</h2><p class="mt-1 text-sm text-slate-600">Geplante Zeiten stammen aus den Angebotsentwürfen; hier werden die tatsächlich geleisteten Zeiten erfasst.</p><div class="mt-4 grid gap-4 md:grid-cols-2"><div class="rounded-lg bg-slate-50 p-4"><p class="text-sm font-medium">Geplant</p><p class="mt-1 text-2xl font-semibold"><%= @order.offers.sum { |offer| offer.planned_time_cost_total }.then { |cost| number_to_currency(cost, unit: "€", format: "%n %u") } %></p><p class="text-sm text-slate-600">interne Kosten aus Angebotsplanung</p></div><div class="rounded-lg bg-slate-50 p-4"><p class="text-sm font-medium">Tatsächlich</p><p class="mt-1 text-2xl font-semibold"><%= @actual_time_entries.sum(&:cost_total).then { |cost| number_to_currency(cost, unit: "€", format: "%n %u") } %></p><p class="text-sm text-slate-600"><%= @actual_time_entries.sum(&:minutes) %> Minuten erfasst</p></div></div><% if @actual_time_entries.any? %><ul class="mt-4 space-y-2 text-sm"><% @actual_time_entries.each do |entry| %><li class="flex flex-wrap items-center justify-between gap-2 rounded-lg bg-slate-50 px-3 py-2"><span><%= entry.category == "organisation" ? "Organisation" : "Durchführung" %> · <%= entry.minutes %> Min. · <%= entry.admin_user&.name || "Ohne Zuordnung" %><%= " · #{entry.note}" if entry.note.present? %></span><%= button_to "Entfernen", admin_order_actual_time_entry_path(@order, entry), method: :delete, class: "font-semibold text-rose-700" %></li><% end %></ul><% end %><%= form_with model: [ :admin, @order, TimeEntry.new ], url: admin_order_actual_time_entries_path(@order), class: "mt-4 grid gap-3 md:grid-cols-4" do |f| %><div><%= f.label :category, "Bereich", class: "block text-sm font-medium" %><%= f.select :category, [["Organisation", "organisation"], ["Durchführung", "execution"]], {}, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div><%= f.label :minutes, "Minuten", class: "block text-sm font-medium" %><%= f.number_field :minutes, min: 1, required: true, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div><%= f.label :recorded_on, "Datum", class: "block text-sm font-medium" %><%= f.date_field :recorded_on, value: Date.current, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div><%= f.label :note, "Notiz", class: "block text-sm font-medium" %><%= f.text_field :note, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div><%= f.submit "Ist-Zeit speichern", class: "admin-cta" %></div><% end %></section>
<section class="mt-6 rounded-xl border border-slate-200 bg-white p-5"><h2 class="font-semibold">Arbeitschecklisten</h2><p class="mt-1 text-sm text-slate-600">Vorlagen werden als eigene Momentaufnahme zum Auftrag hinzugefügt.</p><% if @checklist_templates.any? %><%= form_with url: admin_order_checklists_path(@order), class: "mt-4 flex flex-wrap items-end gap-3" do |f| %><div><%= f.label :checklist_template_id, "Vorlage", class: "block text-sm font-medium" %><%= f.collection_select :checklist_template_id, @checklist_templates, :id, :name, { include_blank: "Bitte wählen" }, required: true, class: "mt-1 rounded border border-slate-300 px-3 py-2" %></div><%= f.submit "Checkliste hinzufügen", class: "admin-cta" %><% end %><% else %><p class="mt-3 text-sm text-slate-600">Lege zuerst unter Checklisten eine Vorlage an.</p><% end %><% @checklists.each do |checklist| %><article class="mt-4 rounded-lg bg-slate-50 p-4"><div class="flex flex-wrap items-center justify-between gap-2"><div><h3 class="font-medium"><%= checklist.name %></h3><p class="text-sm text-slate-600"><%= checklist.status == "completed" ? "Abgeschlossen" : "Offen" %> · <%= checklist.items.where(completed: true).count %>/<%= checklist.items.count %> erledigt</p></div></div><ul class="mt-3 space-y-2 text-sm"><% checklist.items.order(:position, :id).each do |item| %><li class="rounded bg-white px-3 py-2"><%= form_with model: [ :admin, @order, checklist, item ], url: admin_order_checklist_item_path(@order, checklist, item), method: :patch, class: "flex flex-wrap items-start gap-3" do |f| %><%= f.check_box :completed, class: "mt-1" %><div class="min-w-48 flex-1"><strong class="<%= 'line-through text-slate-500' if item.completed? %>"><%= item.title %></strong><% if item.instructions.present? %><p class="mt-1 text-slate-600"><%= item.instructions %></p><% end %><% if item.link_url.present? %><%= link_to "Link", item.link_url, target: "_blank", rel: "noopener", class: "underline" %><% end %><% if item.video_url.present? %><%= link_to "Video", item.video_url, target: "_blank", rel: "noopener", class: "ml-2 underline" %><% end %></div><%= f.submit "Speichern", class: "font-semibold text-slate-700" %><% end %></li><% end %></ul></article><% end %></section>
