<div class="admin-toolbar"><div><p class="proof-kicker"><%= section %></p><h1 class="mt-2 text-3xl font-semibold"><%= order.customer_name %></h1><p class="mt-1 text-slate-600"><%= order.event_date || "Termin offen" %> · <%= order.event_location %></p></div><div class="flex items-center gap-4"><% if order.archived? %><%= button_to "Wiederherstellen", unarchive_admin_order_path(order), method: :patch, class: "admin-secondary-action" %><% else %><%= button_to "Archivieren", archive_admin_order_path(order), method: :patch, class: "admin-secondary-action" %><% end %><%= link_to "Alle Aufträge", admin_orders_path, class: "admin-link" %></div></div>
