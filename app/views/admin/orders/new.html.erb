<div class="admin-toolbar"><div><p class="proof-kicker">Auftragszentrale</p><h1 class="mt-2 text-3xl font-semibold">Auftrag anlegen</h1></div></div>
<%= render "shared/form_errors", object: @order %>
<%= form_with model: [ :admin, @order ], class: "space-y-4" do |f| %>
  <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
    <%= label_tag :order_template_id, "Auftragsvorlage (optional)", class: "block text-sm font-medium" %>
    <%= select_tag :order_template_id, options_from_collection_for_select(@order_templates, :id, :name, @selected_order_template&.id), include_blank: "Ohne Vorlage", class: "mt-1 w-full rounded border border-slate-300 px-3 py-2", data: { controller: "order-template-preview", action: "change->order-template-preview#change" } %>
  </div>
  <div class="grid gap-4 md:grid-cols-2" data-controller="order-customer-contact">
    <div><%= f.label :customer_id, "Kunde", class: "block text-sm font-medium" %><%= f.collection_select :customer_id, @customers, :id, :name, { include_blank: "Neuer / einmaliger Kunde" }, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2", data: { order_customer_contact_target: "customer", action: "change->order-customer-contact#loadContacts" } %></div>
    <div><%= f.label :contact_id, "Ansprechpartner", class: "block text-sm font-medium" %><%= f.collection_select :contact_id, @contacts, :id, :name, { include_blank: "Ohne Ansprechpartner" }, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2", data: { order_customer_contact_target: "contact", order_customer_contact_selected_id: @order.contact_id, action: "change->order-customer-contact#applyContact" } %></div>
    <div><%= f.label :customer_name, "Name oder Firma", class: "block text-sm font-medium" %><%= f.text_field :customer_name, required: true, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2", data: { order_customer_contact_target: "name" } %></div>
    <div><%= f.label :responsible_admin_user_id, "Verantwortlich", class: "block text-sm font-medium" %><%= f.collection_select :responsible_admin_user_id, @admin_users, :id, :name, {}, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div>
    <div><%= f.label :event_date, "Veranstaltungsdatum", class: "block text-sm font-medium" %><%= f.date_field :event_date, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div>
    <div><%= f.label :event_location, "Veranstaltungsort", class: "block text-sm font-medium" %><%= f.text_field :event_location, required: true, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div>
    <div><%= f.label :customer_email, "E-Mail", class: "block text-sm font-medium" %><%= f.email_field :customer_email, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2", data: { order_customer_contact_target: "email" } %></div>
    <div><%= f.label :customer_phone, "Telefon", class: "block text-sm font-medium" %><%= f.telephone_field :customer_phone, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2", data: { order_customer_contact_target: "phone" } %></div>
    <div><%= f.label :start_time, "Beginn", class: "block text-sm font-medium" %><%= german_time_field(f, :start_time, class_name: "mt-1 w-full rounded border border-slate-300 px-3 py-2") %></div>
    <div><%= f.label :end_time, "Ende", class: "block text-sm font-medium" %><%= german_time_field(f, :end_time, class_name: "mt-1 w-full rounded border border-slate-300 px-3 py-2") %></div>
  </div>
  <%= f.submit "Auftrag erstellen", class: "admin-cta" %>
<% end %>
