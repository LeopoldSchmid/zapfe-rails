<div class="admin-toolbar"><div><p class="proof-kicker">Auftragszentrale</p><h1 class="mt-2 text-3xl font-semibold">Auftrag anlegen</h1></div></div>
<%= render "shared/form_errors", object: @order %>
<%= form_with model: [ :admin, @order ], class: "space-y-4" do |f| %><div class="grid gap-4 md:grid-cols-2"><div><%= f.label :customer_name, "Name oder Firma", class: "block text-sm font-medium" %><%= f.text_field :customer_name, required: true, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div><%= f.label :responsible_admin_user_id, "Verantwortlich", class: "block text-sm font-medium" %><%= f.collection_select :responsible_admin_user_id, @admin_users, :id, :name, {}, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div><%= f.label :event_date, "Veranstaltungsdatum", class: "block text-sm font-medium" %><%= f.date_field :event_date, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div><%= f.label :event_location, "Veranstaltungsort", class: "block text-sm font-medium" %><%= f.text_field :event_location, required: true, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div><%= f.label :customer_email, "E-Mail", class: "block text-sm font-medium" %><%= f.email_field :customer_email, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div><%= f.label :customer_phone, "Telefon", class: "block text-sm font-medium" %><%= f.telephone_field :customer_phone, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div></div><div><%= f.label :next_step, "Nächster Schritt", class: "block text-sm font-medium" %><%= f.text_area :next_step, rows: 2, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div><%= f.label :next_step_due_on, "Fällig am", class: "block text-sm font-medium" %><%= f.date_field :next_step_due_on, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><%= f.submit "Auftrag erstellen", class: "admin-cta" %><% end %>
