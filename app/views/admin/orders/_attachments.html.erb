<section class="admin-panel"><h2 class="text-lg font-semibold text-[var(--color-zapfe-navy)]">Auftragsanlagen</h2><%= form_with url: add_attachments_admin_order_path(@order), multipart: true, class: "mt-4 flex flex-wrap items-center gap-3" do |f| %><%= file_field_tag "order[attachments][]", multiple: true, accept: "application/pdf,image/jpeg,image/png,image/webp", class: "text-sm" %><%= f.submit "Hinzufügen", class: "admin-secondary-action" %><% end %><% if @order.attachments.attached? %><ul class="mt-4 space-y-2 text-sm"><% @order.attachments.each do |attachment| %><li><%= link_to attachment.filename, attachment_admin_order_path(@order, attachment), class: "admin-link underline" %></li><% end %></ul><% end %></section>
