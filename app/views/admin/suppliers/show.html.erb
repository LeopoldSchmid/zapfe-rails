<div class="admin-toolbar">
  <div>
    <p class="proof-kicker">Lieferant</p>
    <div class="mt-2 flex flex-wrap items-center gap-3"><h1 class="text-3xl font-semibold text-[var(--color-zapfe-navy)]"><%= @supplier.name %></h1><% if @supplier.default_supplier? %><span class="admin-product-badge">Standardlieferant</span><% end %></div>
    <p class="mt-2 text-sm text-slate-600"><%= [@supplier.email, @supplier.phone].compact_blank.join(" · ").presence || "Keine Kontaktdaten" %></p>
  </div>
  <div class="flex flex-wrap gap-2"><%= link_to "Lieferant bearbeiten", edit_admin_supplier_path(@supplier), class: "admin-secondary-action" %><%= link_to "Angebot hinzufügen", new_admin_supplier_offering_path(supplier_id: @supplier.id), class: "admin-cta" %></div>
</div>

<section class="admin-panel mt-6" data-controller="catalog-variant-picker">
  <div class="flex flex-wrap items-end justify-between gap-3"><div><h2 class="text-xl font-semibold text-[var(--color-zapfe-navy)]">Sortiment</h2><p class="mt-1 text-sm text-slate-600">EK, Gebinde und Beschaffungsregeln dieses Lieferanten.</p></div><div class="w-full sm:w-72"><label class="admin-field-label" for="supplier-offering-search">Im Sortiment suchen</label><input id="supplier-offering-search" type="search" placeholder="Artikel oder Gebinde" class="admin-field" data-catalog-variant-picker-target="query" data-action="input->catalog-variant-picker#filterCards" /></div></div>
  <% if @supplier.supplier_offerings.any? %>
    <div class="mt-5 overflow-x-auto"><table class="min-w-full text-sm"><thead class="border-b border-slate-200 text-left text-xs uppercase tracking-wide text-slate-500"><tr><th class="px-3 py-3">Artikel</th><th class="px-3 py-3">Gebinde</th><th class="px-3 py-3">EK</th><th class="px-3 py-3">Profil</th><th class="px-3 py-3">Rückgabe</th><th class="px-3 py-3"></th></tr></thead><tbody><% @supplier.supplier_offerings.includes(:procurement_profile, :supplier_prices, product_variant: :product).sort_by { |offering| offering.product_variant.display_label }.each do |offering| %><% price = offering.current_price %><tr class="border-b border-slate-100" data-catalog-variant-picker-target="card" data-search-text="<%= [offering.product_variant.display_label, offering.package_label, offering.procurement_profile.name].join(' ').downcase %>"><td class="px-3 py-4 font-medium"><%= offering.product_variant.display_label %><% unless offering.active? %><span class="ml-2 text-xs text-slate-500">inaktiv</span><% end %></td><td class="px-3 py-4"><%= offering.package_label %></td><td class="px-3 py-4"><%= number_to_currency(price&.gross_purchase_price || 0, unit: "€", format: "%n %u") %> brutto<br><span class="text-slate-500"><%= number_to_currency(price&.purchase_price || 0, unit: "€", format: "%n %u") %> netto</span></td><td class="px-3 py-4"><%= offering.procurement_profile.name %><br><span class="text-slate-500"><%= offering.lead_time_days %> Tage</span></td><td class="px-3 py-4"><%= { "unknown" => "offen", "returnable" => "möglich", "non_returnable" => "nein" }.fetch(offering.return_policy) %><%= " · #{offering.return_period_days} T." if offering.return_period_days.present? %></td><td class="px-3 py-4 text-right"><%= link_to "Bearbeiten", edit_admin_supplier_offering_path(offering), class: "admin-link" %></td></tr><% end %></tbody></table></div>
  <% else %>
    <p class="mt-5 text-sm text-slate-600">Noch keine Angebote gepflegt.</p>
  <% end %>
</section>
