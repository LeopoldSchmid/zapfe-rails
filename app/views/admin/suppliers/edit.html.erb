<div class="admin-toolbar"><div><p class="proof-kicker">Beschaffung</p><h1 class="mt-2 text-3xl font-semibold"><%= @supplier.name %></h1></div></div>
<%= render "form" %>

<section class="mt-6 rounded-xl border border-slate-200 bg-white p-5">
  <div class="flex flex-wrap items-center justify-between gap-3"><div><h2 class="font-semibold">Händlerangebote</h2><p class="mt-1 text-sm text-slate-600">Für jede Variante legst du hier Bezugsquelle, Standardprofil und EK-Preis fest.</p></div><%= link_to "Händlerangebot anlegen", new_admin_supplier_offering_path, class: "admin-cta" %></div>
  <div class="mt-4 divide-y divide-slate-100">
    <% @supplier.supplier_offerings.sort_by { |offering| [offering.product_variant.product.brand, offering.product_variant.product.name, offering.product_variant.size] }.each do |offering| %>
      <div class="flex flex-wrap items-center justify-between gap-3 py-3"><div><p class="font-medium"><%= offering.product_variant.product.brand %> <%= offering.product_variant.product.name %> · <%= offering.product_variant.size %> l</p><p class="mt-1 text-sm text-slate-600"><%= offering.procurement_profile.name %> · <%= number_to_currency(offering.current_price&.purchase_price || 0, unit: "€", format: "%n %u") %> netto EK</p></div><%= link_to "Bearbeiten", edit_admin_supplier_offering_path(offering), class: "rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm font-semibold text-slate-700" %></div>
    <% end %>
  </div>
</section>
