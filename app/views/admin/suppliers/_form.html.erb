<%= render "shared/form_errors", object: @supplier %>
<%= form_with model: [ :admin, @supplier ], class: "space-y-6" do |f| %>
  <section class="rounded-xl border border-slate-200 bg-white p-5"><h2 class="font-semibold">Stammdaten</h2><div class="mt-4 grid gap-4 md:grid-cols-2"><div><%= f.label :name, "Name", class: "block text-sm font-medium" %><%= f.text_field :name, required: true, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div><%= f.label :email, "E-Mail", class: "block text-sm font-medium" %><%= f.email_field :email, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div><%= f.label :phone, "Telefon", class: "block text-sm font-medium" %><%= f.telephone_field :phone, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div></div><div class="mt-4"><%= f.label :notes, "Interne Notiz", class: "block text-sm font-medium" %><%= f.text_area :notes, rows: 3, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div class="mt-4 flex flex-wrap gap-5 text-sm"><label class="inline-flex items-center gap-2"><%= f.check_box :active %> Lieferant aktiv</label><label class="inline-flex items-center gap-2"><%= f.check_box :default_supplier %> Standardlieferant</label></div></section>
  <section class="rounded-xl border border-slate-200 bg-white p-5"><h2 class="font-semibold">Individuelle Beschaffungsprofile</h2><p class="mt-1 text-sm text-slate-600">Die Standardprofile Lagerware, Bestellware und Sonderbestellung werden beim einzelnen Händlerangebot ausgewählt. Hier kannst du nur zusätzliche Sonderfälle für diesen Lieferanten anlegen.</p><div class="mt-4 space-y-4"><%= f.fields_for :procurement_profiles do |profile_form| %><div class="rounded-lg border border-slate-200 p-4"><div class="grid gap-3 md:grid-cols-3"><div><%= profile_form.label :name, "Bezeichnung", class: "block text-sm font-medium" %><%= profile_form.text_field :name, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div><%= profile_form.label :lead_time_days, "Vorlauf (Tage)", class: "block text-sm font-medium" %><%= profile_form.number_field :lead_time_days, min: 0, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div><%= profile_form.label :return_policy, "Rückgabe", class: "block text-sm font-medium" %><%= profile_form.select :return_policy, [["Unbekannt", "unknown"], ["Rückgabefähig", "returnable"], ["Nicht rückgabefähig", "non_returnable"]], {}, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div></div><div class="mt-3"><%= profile_form.label :delivery_notes, "Lieferhinweise", class: "block text-sm font-medium" %><%= profile_form.text_area :delivery_notes, rows: 2, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div class="mt-3"><%= profile_form.label :cancellation_notes, "Storno-/Rückgabehinweise", class: "block text-sm font-medium" %><%= profile_form.text_area :cancellation_notes, rows: 2, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><% if profile_form.object.persisted? %><label class="mt-3 inline-flex items-center gap-2 text-sm"><%= profile_form.check_box :_destroy %> Profil entfernen</label><% end %></div><% end %></div></section>
  <div class="flex gap-3"><%= f.submit class: "admin-cta" %><%= link_to "Abbrechen", admin_suppliers_path, class: "rounded-xl border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700" %></div>
<% end %>
