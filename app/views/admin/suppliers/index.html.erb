<div class="admin-toolbar">
  <div>
    <p class="proof-kicker">Beschaffung</p>
    <h1 class="mt-2 text-3xl font-semibold text-[var(--color-zapfe-navy)]">Lieferanten</h1>
  </div>
  <div class="flex flex-wrap gap-2">
    <%= link_to "Standardprofile", ProcurementProfile.standard.order(:name).first ? edit_admin_procurement_profile_path(ProcurementProfile.standard.order(:name).first) : admin_suppliers_path, class: "admin-secondary-action" %>
    <%= link_to "Lieferant anlegen", new_admin_supplier_path, class: "admin-cta" %>
  </div>
</div>

<section class="admin-panel mt-6">
  <div class="flex items-baseline justify-between gap-3"><h2 class="text-lg font-semibold">Lieferantenübersicht</h2><span class="text-sm text-slate-500"><%= @suppliers.count %> Einträge</span></div>
  <div class="mt-4 divide-y divide-slate-100">
    <% @suppliers.each do |supplier| %>
      <%= link_to admin_supplier_path(supplier), class: "flex flex-wrap items-center justify-between gap-4 py-4 transition hover:bg-slate-50" do %>
        <div>
          <div class="flex flex-wrap items-center gap-2"><strong><%= supplier.name %></strong><% if supplier.default_supplier? %><span class="admin-product-badge">Standard</span><% end %><% unless supplier.active? %><span class="admin-product-badge-muted">Inaktiv</span><% end %></div>
          <p class="mt-1 text-sm text-slate-600"><%= [supplier.email, supplier.phone].compact_blank.join(" · ").presence || "Keine Kontaktdaten" %></p>
        </div>
        <div class="text-right text-sm text-slate-600"><strong class="block text-[var(--color-zapfe-navy)]"><%= supplier.supplier_offerings.count(&:active?) %> aktive Angebote</strong><span>Sortiment öffnen</span></div>
      <% end %>
    <% end %>
  </div>
</section>
