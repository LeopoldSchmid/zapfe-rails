<div class="admin-toolbar">
  <div><p class="proof-kicker">Beschaffung</p><h1 class="mt-2 text-3xl font-semibold text-[var(--color-zapfe-navy)]">Lieferanten</h1></div>
  <div class="flex gap-2"><%= link_to "Standardprofile", ProcurementProfile.standard.order(:name).first ? edit_admin_procurement_profile_path(ProcurementProfile.standard.order(:name).first) : admin_suppliers_path, class: "rounded-xl border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700" %><%= link_to "Händlerangebot anlegen", new_admin_supplier_offering_path, class: "rounded-xl border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700" %><%= link_to "Lieferant anlegen", new_admin_supplier_path, class: "admin-cta" %></div>
  <div class="mt-3 flex flex-wrap gap-2 text-sm"><% ProcurementProfile.standard.order(:name).each do |profile| %><%= link_to profile.name, edit_admin_procurement_profile_path(profile), class: "rounded-full bg-slate-100 px-3 py-1 font-medium text-slate-700 hover:bg-slate-200" %><% end %></div>
</div>

<div class="mt-6 space-y-4">
  <% @suppliers.each do |supplier| %>
    <article class="rounded-xl border border-slate-200 bg-white p-5">
      <div class="flex flex-col justify-between gap-3 md:flex-row"><div><div class="flex items-center gap-2"><h2 class="font-semibold"><%= supplier.name %></h2><% if supplier.default_supplier? %><span class="rounded-full bg-amber-100 px-2 py-1 text-xs font-semibold text-amber-900">Standard</span><% end %><% unless supplier.active? %><span class="rounded-full bg-slate-100 px-2 py-1 text-xs font-semibold text-slate-600">Inaktiv</span><% end %></div><p class="mt-1 text-sm text-slate-600"><%= [supplier.email, supplier.phone].compact_blank.join(" · ").presence || "Keine Kontaktdaten" %></p></div><%= link_to "Bearbeiten", edit_admin_supplier_path(supplier), class: "admin-cta" %></div>
      <div class="mt-4 grid gap-3 md:grid-cols-2"><% supplier.procurement_profiles.each do |profile| %><div class="rounded-lg bg-slate-50 p-3 text-sm"><p class="font-medium"><%= profile.name %></p><p class="mt-1 text-slate-600"><%= profile.lead_time_days %> Tage Vorlauf · <%= { "unknown" => "Rückgabe offen", "returnable" => "rückgabefähig", "non_returnable" => "nicht rückgabefähig" }.fetch(profile.return_policy) %></p><p class="mt-1 text-slate-500"><%= profile.supplier_offerings.size %> zugeordnete Varianten</p></div><% end %></div>
    </article>
  <% end %>
</div>
