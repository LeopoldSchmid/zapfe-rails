<div class="admin-toolbar"><div><p class="proof-kicker">Anfrage</p><h1 class="mt-2 text-3xl font-semibold"><%= @inquiry.customer_name %></h1><p class="mt-1 text-slate-600"><%= @inquiry.email %> · <%= @inquiry.phone %></p></div><%= link_to "Zurück", admin_inquiries_path, class: "admin-link" %></div>
<% unless @inquiry.archived? %><%= button_to "Archivieren", archive_admin_inquiry_path(@inquiry), method: :patch, class: "mb-4 rounded-xl border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700" %><% end %>

<div class="grid gap-6 lg:grid-cols-2">
  <section class="rounded-xl border border-slate-200 bg-white p-5"><h2 class="font-semibold">Bearbeitung</h2><%= form_with model: [ :admin, @inquiry ], url: assign_admin_inquiry_path(@inquiry), method: :patch, class: "mt-4 space-y-3" do |f| %><div><%= f.label :assigned_admin_user_id, "Verantwortlich", class: "block text-sm font-medium" %><%= f.collection_select :assigned_admin_user_id, @admin_users, :id, :name, include_blank: "Unzugewiesen", class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div><%= f.label :status, class: "block text-sm font-medium" %><%= f.select :status, Inquiry::STATUSES.map { |status| [inquiry_status_label(status), status] }, {}, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div><%= f.label :next_step, "Nächster Schritt", class: "block text-sm font-medium" %><%= f.text_area :next_step, rows: 2, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div><%= f.label :next_step_due_on, "Fällig am", class: "block text-sm font-medium" %><%= f.date_field :next_step_due_on, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div><%= f.label :closure_reason, "Abschlussgrund", class: "block text-sm font-medium" %><%= f.text_field :closure_reason, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><%= f.submit "Änderungen speichern", class: "admin-cta" %><% end %></section>
  <section class="rounded-xl border border-slate-200 bg-white p-5"><h2 class="font-semibold">Kontakt und Veranstaltung</h2><%= form_with model: [ :admin, @inquiry ], url: assign_admin_inquiry_path(@inquiry), method: :patch, class: "mt-4 space-y-3" do |f| %><div class="grid gap-3 md:grid-cols-2"><div><%= f.label :first_name, "Vorname", class: "block text-sm font-medium" %><%= f.text_field :first_name, required: true, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div><%= f.label :last_name, "Nachname", class: "block text-sm font-medium" %><%= f.text_field :last_name, required: true, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div><%= f.label :email, "E-Mail", class: "block text-sm font-medium" %><%= f.email_field :email, required: true, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div><%= f.label :phone, "Telefon", class: "block text-sm font-medium" %><%= f.telephone_field :phone, required: true, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div><%= f.label :event_type, "Veranstaltung", class: "block text-sm font-medium" %><%= f.text_field :event_type, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div><%= f.label :event_date, "Veranstaltungsdatum", class: "block text-sm font-medium" %><%= f.date_field :event_date, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div><%= f.label :starts_on, "Beginn", class: "block text-sm font-medium" %><%= f.date_field :starts_on, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div><%= f.label :ends_on, "Ende", class: "block text-sm font-medium" %><%= f.date_field :ends_on, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div><%= f.label :start_time, "Startzeit", class: "block text-sm font-medium" %><%= f.time_field :start_time, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div><%= f.label :end_time, "Endzeit", class: "block text-sm font-medium" %><%= f.time_field :end_time, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div><%= f.label :guests, "Gäste", class: "block text-sm font-medium" %><%= f.number_field :guests, min: 0, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div><%= f.label :delivery_street, "Straße und Hausnummer", class: "block text-sm font-medium" %><%= f.text_field :delivery_street, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div><%= f.label :delivery_postcode, "PLZ", class: "block text-sm font-medium" %><%= f.text_field :delivery_postcode, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div><%= f.label :delivery_city, "Ort", class: "block text-sm font-medium" %><%= f.text_field :delivery_city, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div></div><div><%= f.label :message, "Kundennachricht", class: "block text-sm font-medium" %><%= f.text_area :message, rows: 3, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><%= f.submit "Kontakt und Veranstaltung speichern", class: "admin-cta" %><% end %><% if @inquiry.order %><%= link_to "Zugehörigen Auftrag öffnen", admin_order_path(@inquiry.order), class: "admin-cta mt-5 inline-block" %><% else %><%= button_to "In Auftrag umwandeln", convert_to_order_admin_inquiry_path(@inquiry), method: :post, class: "admin-cta mt-5" %><% end %></section>
</div>

<section class="mt-6 rounded-xl border border-slate-200 bg-white p-5"><h2 class="font-semibold">Chronik</h2><% if @activities.any? %><ol class="mt-4 space-y-3"><% @activities.each do |activity| %><li class="border-l-2 border-slate-200 pl-3 text-sm"><p class="font-medium"><%= activity.message %></p><p class="text-slate-500"><%= activity.admin_user.name %> · <%= l(activity.created_at, format: :short) %></p></li><% end %></ol><% else %><p class="mt-3 text-sm text-slate-600">Noch keine Aktivitäten.</p><% end %></section>
<%= form_with url: add_note_admin_inquiry_path(@inquiry), class: "mt-3 flex gap-3" do |f| %><%= text_field_tag :note, nil, required: true, placeholder: "Interne Notiz", class: "flex-1 rounded border border-slate-300 px-3 py-2" %><%= f.submit "Notiz speichern", class: "admin-cta" %><% end %>

<section class="mt-6 rounded-xl border border-slate-200 bg-white p-5"><h2 class="font-semibold">Anlagen</h2><%= form_with url: add_attachments_admin_inquiry_path(@inquiry), multipart: true, class: "mt-3 flex flex-wrap gap-3" do |f| %><%= file_field_tag "inquiry[attachments][]", multiple: true, accept: "application/pdf,image/jpeg,image/png,image/webp", class: "text-sm" %><%= f.submit "Hinzufügen", class: "admin-cta" %><% end %><ul class="mt-4 space-y-2 text-sm"><% @inquiry.attachments.each do |attachment| %><li><%= link_to attachment.filename, attachment_admin_inquiry_path(@inquiry, attachment), class: "underline" %></li><% end %></ul></section>
