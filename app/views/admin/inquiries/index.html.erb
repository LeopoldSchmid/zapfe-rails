<div class="admin-toolbar">
  <div><p class="proof-kicker">Eingang</p><h1 class="mt-2 text-3xl font-semibold text-[var(--color-zapfe-navy)]">Anfragen</h1></div>
  <div class="flex flex-wrap gap-2"><%= link_to "Nur unzugewiesen", admin_inquiries_path(unassigned: 1), class: "admin-secondary-action" %>
  <%= link_to "Heute fällig", admin_inquiries_path(due: "overdue"), class: "rounded-xl border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700" %>
  <%= link_to "Nächste 7 Tage", admin_inquiries_path(due: "next_7_days"), class: "rounded-xl border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700" %>
  <%= link_to "Archiv", admin_inquiries_path(archived: 1), class: "admin-secondary-action" %><%= link_to "Alle Filter entfernen", admin_inquiries_path(clear_filters: 1), class: "admin-danger-action" if @active_filters.any? %></div>
</div>
<% if @active_filters.any? %><div class="mb-4 flex flex-wrap items-center gap-2 text-sm"><span class="text-slate-500">Aktive Filter:</span><% @active_filters.each do |key, value| %><% label = case key; when "status" then inquiry_status_label(value); when "unassigned" then "Unzugewiesen"; when "due" then value == "overdue" ? "Heute fällig" : "Nächste 7 Tage"; when "archived" then "Archiv"; when "assigned_admin_user_id" then @admin_users.find_by(id: value)&.name; end %><span class="rounded-full bg-[var(--color-zapfe-navy)] px-3 py-1 font-medium text-white"><%= label %></span><% end %></div><% else %><p class="mb-4 text-sm text-slate-500">Es werden nur bearbeitungsrelevante Anfragen angezeigt. Abgeschlossene Anfragen erscheinen bei gezielter Auswahl.</p><% end %>

<div class="mb-4 flex flex-wrap gap-2 text-sm">
  <% Inquiry::STATUSES.each do |status| %>
    <%= link_to inquiry_status_label(status), admin_inquiries_path(status: status), class: "rounded-full border border-slate-300 px-3 py-1" %>
  <% end %>
  <% @admin_users.each do |admin_user| %>
    <%= link_to admin_user.name, admin_inquiries_path(assigned_admin_user_id: admin_user.id), class: "rounded-full border border-slate-300 px-3 py-1" %>
  <% end %>
</div>

<div class="space-y-3">
  <% @inquiries.each do |inquiry| %>
    <article class="rounded-xl border <%= inquiry.assigned_admin_user.nil? && inquiry.open? ? 'border-amber-400 bg-amber-50' : 'border-slate-200 bg-white' %> p-4">
      <div class="flex flex-col justify-between gap-3 md:flex-row"><div><p class="font-semibold"><%= inquiry.customer_name %> <span class="font-normal text-slate-500">· <%= inquiry.event_date || inquiry.starts_on || "Termin offen" %></span></p><p class="mt-1 text-sm text-slate-600"><%= inquiry.event_type.presence || "Anfrage" %> · <%= inquiry_status_label(inquiry.status) %> · <%= inquiry.assigned_admin_user&.name || "Unzugewiesen" %></p><% if inquiry.next_step.present? %><p class="mt-2 text-sm"><strong>Nächster Schritt:</strong> <%= inquiry.next_step %></p><% end %></div><%= link_to "Öffnen", admin_inquiry_path(inquiry), class: "admin-cta" %></div>
    </article>
  <% end %>
</div>
<%= render "admin/shared/pagination" %>
