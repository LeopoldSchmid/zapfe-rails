<div class="admin-toolbar"><div><p class="proof-kicker">Arbeitsvorlagen</p><h1 class="mt-2 text-3xl font-semibold">Checklisten</h1><p class="mt-1 text-slate-600">Pflegbare Abläufe für Packen, Aufbau und Reinigung.</p></div><%= link_to "Vorlage anlegen", new_admin_checklist_template_path, class: "admin-cta" %></div>
<div class="mt-6 space-y-3"><% @checklist_templates.each do |template| %><article class="rounded-xl border border-slate-200 bg-white p-5"><div class="flex items-start justify-between gap-4"><div><h2 class="font-semibold"><%= template.name %></h2><p class="mt-1 text-sm text-slate-600"><%= template.resource_type.presence || "Allgemein" %> · <%= { "packing" => "Packen", "setup" => "Aufbau", "cleaning" => "Reinigung" }.fetch(template.section) %> · <%= template.active? ? "Aktiv" : "Inaktiv" %></p><p class="mt-2 text-sm"><%= pluralize(template.items.count, "Punkt", "Punkte") %></p></div><%= link_to "Bearbeiten", edit_admin_checklist_template_path(template), class: "admin-link" %></div></article><% end %><% if @checklist_templates.empty? %><p class="rounded-xl border border-dashed border-slate-300 p-5 text-slate-600">Noch keine Vorlagen angelegt.</p><% end %></div>
