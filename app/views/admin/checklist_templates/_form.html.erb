<%= render "shared/form_errors", object: @checklist_template %>
<%= form_with model: [ :admin, @checklist_template ], class: "max-w-4xl space-y-5 rounded-xl border border-slate-200 bg-white p-5" do |f| %>
  <div class="grid gap-4 md:grid-cols-3"><div><%= f.label :name, "Name", class: "block text-sm font-medium" %><%= f.text_field :name, required: true, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div><%= f.label :resource_type, "Ressourcentyp (optional)", class: "block text-sm font-medium" %><%= f.text_field :resource_type, placeholder: "Ape oder Kegerator", class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div><%= f.label :section, "Bereich", class: "block text-sm font-medium" %><%= f.select :section, [["Packen", "packing"], ["Aufbau", "setup"], ["Reinigung", "cleaning"]], {}, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div></div>
  <label class="inline-flex items-center gap-2 text-sm"><%= f.check_box :active %> Vorlage kann auf Aufträge angewendet werden</label>
  <fieldset class="space-y-4 border-t border-slate-200 pt-5"><legend class="font-semibold">Punkte</legend><%= f.fields_for :items do |item| %><div class="rounded-lg bg-slate-50 p-4"><%= item.hidden_field :id %><div class="grid gap-3 md:grid-cols-2"><div><%= item.label :title, "Prüfpunkt", class: "block text-sm font-medium" %><%= item.text_field :title, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div><%= item.label :position, "Reihenfolge", class: "block text-sm font-medium" %><%= item.number_field :position, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div class="md:col-span-2"><%= item.label :instructions, "Anleitung", class: "block text-sm font-medium" %><%= item.text_area :instructions, rows: 2, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div><%= item.label :link_url, "Link", class: "block text-sm font-medium" %><%= item.url_field :link_url, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div><%= item.label :video_url, "Video-Link", class: "block text-sm font-medium" %><%= item.url_field :video_url, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div><%= item.label :attachment, "Datei oder Bild", class: "block text-sm font-medium" %><%= item.file_field :attachment, class: "mt-1 text-sm" %></div><label class="self-end inline-flex items-center gap-2 text-sm"><%= item.check_box :_destroy %> Punkt entfernen</label></div></div><% end %></fieldset>
  <%= f.submit class: "admin-cta" %>
<% end %>
