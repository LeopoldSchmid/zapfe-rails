<div class="admin-toolbar">
  <div>
    <p class="proof-kicker">Katalog</p>
    <h1 class="mt-2 text-3xl font-semibold text-[var(--color-zapfe-navy)]">Produkte</h1>
    <p class="mt-2 max-w-2xl text-sm text-slate-500">Quick-Edit fur Preise, Sortiment und Favoriten. Detailfelder, Varianten und Bilder bleiben direkt erreichbar.</p>
  </div>
  <div class="flex flex-wrap items-center gap-3">
    <span class="rounded-full border border-slate-200 bg-white px-3 py-2 text-sm text-slate-600 shadow-sm"><%= @products.size %> Produkte</span>
    <details class="admin-bulk-details"><summary><span>CSV-Import</span><span class="text-xs font-medium text-slate-500">Produkte & Varianten</span></summary><div class="mt-4 border-t border-slate-200 pt-4"><p class="text-sm text-slate-600">Eine Zeile entspricht einer Variante. Bestehende Artikelnummern und SKUs werden aktualisiert.</p><%= link_to "CSV-Vorlage laden", import_template_admin_products_path, class: "admin-link mt-3 inline-block" %><%= form_with url: import_admin_products_path, multipart: true, class: "mt-3 flex flex-wrap items-center gap-3" do |f| %><%= file_field_tag :file, accept: ".csv,text/csv", required: true, class: "text-sm" %><%= f.submit "CSV importieren", class: "admin-secondary-action" %><% end %></div></details>
    <%= link_to "Neues Produkt", new_admin_product_path, class: "admin-cta" %>
  </div>
</div>

<div data-controller="bulk-pricing admin-product-search">
  <div class="admin-panel mb-5 p-4">
    <div class="grid gap-3 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-center">
      <div>
        <label class="admin-field-label" for="admin-product-search">Produkte suchen</label>
        <div class="relative">
          <input
            id="admin-product-search"
            type="search"
            placeholder="Artikelnummer, Marke, Name, Kategorie, SKU..."
            class="admin-search-input"
            data-admin-product-search-target="query"
            data-action="input->admin-product-search#update"
          />
          <span class="admin-search-count">
            <span data-admin-product-search-target="visibleCount"><%= @products.size %></span>/<%= @products.size %>
          </span>
        </div>
      </div>

      <details class="admin-bulk-details">
        <summary>
          <span>Sammelaktion</span>
          <span class="text-xs font-medium text-slate-500">Preise pro Kategorie</span>
        </summary>

        <div class="mt-4 border-t border-slate-200 pt-4">
          <%= form_with url: bulk_update_prices_admin_products_path, class: "space-y-4" do |f| %>
            <div>
              <%= f.label :category_id, "Kategorie", class: "admin-field-label" %>
              <%= f.collection_select :category_id, @bulk_price_categories, :id, :name, { include_blank: "Kategorie wählen" }, { class: "admin-inline-input", data: { bulk_pricing_target: "categorySelect", action: "change->bulk-pricing#update" } } %>
            </div>

            <div class="admin-bulk-pricing-grid">
              <% @bulk_price_slots.each_with_index do |default_size, index| %>
                <% selected_size = params.fetch(:bulk_sizes, [])[index].presence || default_size %>
                <% entered_price = params.fetch(:bulk_prices, [])[index] %>

                <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4" data-bulk-pricing-target="slotCard">
                  <div class="grid gap-3 sm:grid-cols-2">
                    <div>
                      <label class="admin-field-label" for="bulk-size-<%= index %>">Größe</label>
                      <select
                        id="bulk-size-<%= index %>"
                        name="bulk_sizes[]"
                        class="admin-inline-input"
                        data-bulk-pricing-target="sizeSelect"
                        data-action="change->bulk-pricing#update"
                      >
                        <% @bulk_variant_sizes.each do |value| %>
                          <% label = "#{value.to_f % 1 == 0 ? value.to_i : value}L" %>
                          <option value="<%= value %>" <%= "selected" if value.to_s == selected_size.to_s %>><%= label %></option>
                        <% end %>
                      </select>
                    </div>

                    <div>
                      <label class="admin-field-label" for="bulk-price-<%= index %>">Preis</label>
                      <input
                        id="bulk-price-<%= index %>"
                        type="number"
                        min="0"
                        step="0.01"
                        name="bulk_prices[]"
                        value="<%= entered_price %>"
                        placeholder="z. B. 80.00"
                        class="admin-inline-input"
                        data-bulk-pricing-target="priceInput"
                        data-action="input->bulk-pricing#update change->bulk-pricing#update"
                      />
                    </div>
                  </div>

                  <p class="mt-3 text-sm font-medium text-slate-600">
                    <span class="text-slate-500">Preis pro Liter:</span>
                    <span data-bulk-pricing-target="perLiterOutput">-</span>
                  </p>
                </div>
              <% end %>
            </div>

            <div class="flex justify-end">
              <%= f.submit "Passende Varianten aktualisieren", class: "admin-cta w-full sm:w-auto" %>
            </div>
          <% end %>
        </div>
      </details>
    </div>
  </div>

  <div class="admin-product-list">
    <% @products.each do |product| %>
      <% form_id = dom_id(product, :quick_edit) %>
      <% row_has_errors = defined?(@product) && @product&.id == product.id && @product.errors.any? %>
      <% variant_sizes = product.product_variants.map(&:size).uniq.sort.join(",") %>
      <% search_text = [
        product.article_number,
        product.brand,
        product.name,
        product.kind,
        product.subcategory,
        product.category&.name,
        product.product_variants.map(&:sku),
        product.product_variants.map(&:measurement_label)
      ].flatten.compact.join(" ").downcase %>

      <article
        class="admin-product-card <%= "admin-product-card-error" if row_has_errors %>"
        data-admin-product-search-target="item"
        data-bulk-pricing-target="productRow"
        data-search-text="<%= search_text %>"
        data-category-id="<%= product.category_id %>"
        data-variant-sizes="<%= variant_sizes %>"
      >
        <%= form_with model: [ :admin, product ], id: form_id, class: "hidden" do %>
          <%= hidden_field_tag :return_to, admin_products_path %>
        <% end %>

        <div class="admin-product-card-main">
          <div class="admin-product-media">
            <% if product.image.attached? %>
              <%= image_tag product.image, class: "h-16 w-16 rounded-2xl object-contain bg-slate-50" %>
            <% else %>
              <img src="/placeholder-bottle.png" alt="Kein Bild" class="h-16 w-16 rounded-2xl object-contain bg-slate-50 p-2" />
            <% end %>
          </div>

          <div class="min-w-0">
            <div class="flex flex-wrap items-center gap-2">
              <span class="admin-product-number"><%= product.article_number.presence || "Ohne Artikelnummer" %></span>
              <% if product.featured? %>
                <span class="admin-product-badge">Favorit</span>
              <% end %>
              <% if product.category.present? %>
                <span class="admin-product-badge-muted"><%= product.category.name %></span>
              <% end %>
            </div>

            <h2 class="mt-2 truncate text-lg font-semibold text-[var(--color-zapfe-navy)]"><%= [ product.brand, product.name ].compact.join(" ") %></h2>
            <p class="mt-1 text-sm text-slate-500"><%= [ product.kind, product.subcategory ].compact_blank.join(" · ") %></p>
          </div>
        </div>

        <div class="admin-product-fields">
          <div>
            <label class="admin-field-label" for="<%= "#{form_id}_article_number" %>">Artikelnummer</label>
            <input id="<%= "#{form_id}_article_number" %>" form="<%= form_id %>" type="text" name="product[article_number]" value="<%= product.article_number %>" class="admin-inline-input" />
          </div>
          <div>
            <label class="admin-field-label" for="<%= "#{form_id}_brand" %>">Marke</label>
            <input id="<%= "#{form_id}_brand" %>" form="<%= form_id %>" type="text" name="product[brand]" value="<%= product.brand %>" class="admin-inline-input" />
          </div>
          <div>
            <label class="admin-field-label" for="<%= "#{form_id}_name" %>">Name</label>
            <input id="<%= "#{form_id}_name" %>" form="<%= form_id %>" type="text" name="product[name]" value="<%= product.name %>" class="admin-inline-input" />
          </div>
          <div>
            <label class="admin-field-label" for="<%= "#{form_id}_category_id" %>">Kategorie</label>
            <select id="<%= "#{form_id}_category_id" %>" form="<%= form_id %>" name="product[category_id]" class="admin-inline-input">
              <option value=""></option>
              <% @categories.each do |category| %>
                <option value="<%= category.id %>" <%= "selected" if product.category_id == category.id %>><%= category.name %></option>
              <% end %>
            </select>
          </div>
          <div>
            <label class="admin-field-label" for="<%= "#{form_id}_kind" %>">Typ</label>
            <input id="<%= "#{form_id}_kind" %>" form="<%= form_id %>" type="text" name="product[kind]" value="<%= product.kind %>" class="admin-inline-input" />
          </div>
          <div>
            <label class="admin-field-label" for="<%= "#{form_id}_subcategory" %>">Unterkategorie</label>
            <input id="<%= "#{form_id}_subcategory" %>" form="<%= form_id %>" type="text" name="product[subcategory]" value="<%= product.subcategory %>" class="admin-inline-input" />
          </div>
          <div>
            <label class="admin-field-label" for="<%= "#{form_id}_alcohol_content" %>">Vol. %</label>
            <input id="<%= "#{form_id}_alcohol_content" %>" form="<%= form_id %>" type="number" min="0" step="0.1" name="product[alcohol_content]" value="<%= product.alcohol_content %>" class="admin-inline-input" />
          </div>
          <div>
            <label class="admin-field-label" for="<%= "#{form_id}_featured_position" %>">Position</label>
            <input id="<%= "#{form_id}_featured_position" %>" form="<%= form_id %>" type="number" min="1" step="1" name="product[featured_position]" value="<%= product.featured_position %>" class="admin-inline-input" />
          </div>
        </div>

        <div class="admin-product-options">
          <label class="admin-inline-check">
            <input form="<%= form_id %>" type="hidden" name="product[is_alcoholic]" value="0" />
            <input form="<%= form_id %>" type="checkbox" name="product[is_alcoholic]" value="1" <%= "checked" if product.is_alcoholic? %> />
            <span>Alkoholisch</span>
          </label>

          <label class="admin-inline-check">
            <input form="<%= form_id %>" type="hidden" name="product[featured]" value="0" />
            <input form="<%= form_id %>" type="checkbox" name="product[featured]" value="1" <%= "checked" if product.featured? %> />
            <span>Im Rechner hervorheben</span>
          </label>

          <div class="min-w-0 flex-1">
            <label class="admin-field-label" for="<%= "#{form_id}_featured_note" %>">Hinweis</label>
            <textarea id="<%= "#{form_id}_featured_note" %>" form="<%= form_id %>" name="product[featured_note]" rows="2" maxlength="140" class="admin-inline-input admin-inline-textarea"><%= product.featured_note %></textarea>
          </div>
        </div>

        <div class="admin-product-variants">
          <% if product.product_variants.any? %>
            <% product.product_variants.each do |variant| %>
              <span class="admin-variant-pill">
                <span class="font-semibold text-slate-700"><%= variant.sku %></span>
                <span><%= variant.measurement_label %> · je <%= variant.sales_unit %></span>
                <span><%= number_to_currency(variant.price, unit: "€", separator: ",", delimiter: ".") %></span>
                <span><%= variant.supplier_offerings.count(&:active?) %> Bezugsquellen</span>
                <span><%= variant.is_available? ? "Verfügbar" : "Deaktiviert" %></span>
              </span>
            <% end %>
          <% else %>
            <span class="text-sm text-slate-500">Keine Varianten gepflegt.</span>
          <% end %>
        </div>

        <% if row_has_errors %>
          <p class="rounded-2xl border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700">
            <%= @product.errors.full_messages.to_sentence %>
          </p>
        <% end %>

        <div class="admin-product-actions">
          <button type="submit" form="<%= form_id %>" class="admin-cta">Speichern</button>
          <%= link_to "Details", edit_admin_product_path(product), class: "admin-secondary-action" %>
          <%= button_to "Löschen", admin_product_path(product), method: :delete, class: "admin-danger-action", form: { class: "contents" } %>
        </div>
      </article>
    <% end %>
  </div>

  <div class="admin-empty-state" data-admin-product-search-target="emptyState" data-bulk-pricing-target="emptyState" hidden>
    Keine passenden Produkte gefunden.
  </div>
</div>
