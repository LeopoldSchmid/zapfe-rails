<div class="admin-toolbar"><div><p class="proof-kicker">Angebot · <%= { "draft" => "Entwurf", "finalized" => "Finalisiert", "sent" => "Versendet", "accepted" => "Angenommen", "rejected" => "Abgelehnt", "expired" => "Abgelaufen" }.fetch(@offer.status) %> v<%= @offer.version %></p><h1 class="mt-2 text-3xl font-semibold text-[var(--color-zapfe-navy)]"><%= @offer.recipient_name %></h1><p class="mt-1 text-slate-600"><%= @offer.offer_number.presence || "Noch keine Angebotsnummer" %> · Auftrag: <%= link_to @offer.order.customer_name, admin_order_path(@offer.order), class: "underline" %> · gültig bis <%= l(@offer.valid_until) %></p></div><div class="flex flex-wrap gap-2"><%= link_to "Zum Auftrag", admin_order_path(@offer.order), class: "admin-link" %><% if @offer.editable? %><%= button_to "Angebot finalisieren", finalize_admin_offer_path(@offer), method: :post, class: "admin-cta" %><% else %><%= link_to "PDF herunterladen", document_admin_offer_path(@offer), class: "rounded-xl border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700" if @offer.document.attached? %><%= button_to "Per E-Mail versenden", send_mail_admin_offer_path(@offer), method: :post, class: "admin-cta" if @offer.status == "finalized" %><% if %w[finalized sent].include?(@offer.status) %><%= button_to "Als angenommen markieren", resolve_admin_offer_path(@offer, status: "accepted"), method: :patch, class: "admin-cta" %><%= button_to "Ablehnen", resolve_admin_offer_path(@offer, status: "rejected"), method: :patch, class: "rounded-xl border border-rose-300 bg-white px-4 py-2 text-sm font-semibold text-rose-700" %><%= button_to "Als abgelaufen markieren", resolve_admin_offer_path(@offer, status: "expired"), method: :patch, class: "rounded-xl border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700" %><% end %><%= button_to "Neue Version erstellen", duplicate_admin_offer_path(@offer), method: :post, class: "admin-cta" %><% end %></div></div>

<% unless @offer.editable? %><div class="mb-4 rounded-lg bg-slate-100 px-4 py-3 text-sm text-slate-700">Dieses Angebot ist finalisiert und unveränderlich. Für Anpassungen bitte eine neue Version erstellen.</div><% end %>
<%= render "shared/form_errors", object: @offer %>
<%= form_with model: [ :admin, @offer ], class: "rounded-xl border border-slate-200 bg-white p-5" do |f| %><fieldset<%= " disabled" unless @offer.editable? %>><h2 class="font-semibold">Empfänger und Gültigkeit</h2><div class="mt-4 grid gap-4 md:grid-cols-2"><div><%= f.label :recipient_name, "Name oder Firma", class: "block text-sm font-medium" %><%= f.text_field :recipient_name, required: true, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div><%= f.label :recipient_email, "E-Mail", class: "block text-sm font-medium" %><%= f.email_field :recipient_email, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div><%= f.label :valid_until, "Gültig bis", class: "block text-sm font-medium" %><%= f.date_field :valid_until, required: true, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div></div><div class="mt-4"><%= f.label :recipient_address, "Veranstaltungs-/Empfängeradresse", class: "block text-sm font-medium" %><%= f.text_area :recipient_address, rows: 2, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div class="mt-4 grid gap-4 md:grid-cols-3"><div><%= f.label :global_discount_type, "Gesamtrabatt", class: "block text-sm font-medium" %><%= f.select :global_discount_type, [["Keiner", "none"], ["Prozent", "percent"], ["Festbetrag", "fixed"]], {}, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div><%= f.label :global_discount_value, "Rabattwert", class: "block text-sm font-medium" %><%= f.number_field :global_discount_value, step: 0.01, min: 0, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div><%= f.label :global_discount_reason, "Rabattgrund (sichtbar)", class: "block text-sm font-medium" %><%= f.text_field :global_discount_reason, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div></div><div class="mt-4"><%= f.label :internal_note, "Interne Notiz", class: "block text-sm font-medium" %><%= f.text_area :internal_note, rows: 2, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><%= f.submit "Angebotsdaten speichern", class: "admin-cta mt-4" if @offer.editable? %></fieldset><% end %>

<div class="mt-6 grid gap-6 lg:grid-cols-[1fr_20rem]"><section class="rounded-xl border border-slate-200 bg-white p-5"><div class="flex items-baseline justify-between"><h2 class="font-semibold">Positionen</h2><p class="text-sm text-slate-500">Preise intern netto</p></div><% if @offer.line_items.any? %><div class="mt-4 space-y-4"><% @offer.line_items.order(:position, :created_at).each do |line_item| %><%= form_with model: [ :admin, @offer, line_item ], url: admin_offer_line_item_path(@offer, line_item), method: :patch, class: "rounded-lg border border-slate-200 p-4" do |f| %><fieldset<%= " disabled" unless @offer.editable? %>><div class="grid gap-3 md:grid-cols-4"><div class="md:col-span-2"><%= f.label :description, "Beschreibung", class: "block text-sm font-medium" %><%= f.text_field :description, required: true, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div><%= f.label :quantity, "Menge", class: "block text-sm font-medium" %><%= f.number_field :quantity, step: 0.01, min: 0.01, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div><%= f.label :unit, "Einheit", class: "block text-sm font-medium" %><%= f.text_field :unit, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><% if line_item.product_variant.present? %><div class="md:col-span-2"><%= f.label :supplier_offering_id, "Bezugsquelle (intern)", class: "block text-sm font-medium" %><%= f.select :supplier_offering_id, (@supplier_offerings_by_variant[line_item.product_variant_id] || []).map { |offering| ["#{offering.supplier.name} · #{number_to_currency(offering.current_price&.purchase_price || 0, unit: "€", format: "%n %u")} · #{offering.lead_time_days} Tage", offering.id] }, { include_blank: "Keine Bezugsquelle" }, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div class="self-end text-sm text-slate-600">Direkte Kosten: <strong><%= number_to_currency(line_item.direct_cost_unit || 0, unit: "€", format: "%n %u") %></strong></div><% end %><div><%= f.label :net_unit_price, "Netto/Stück", class: "block text-sm font-medium" %><%= f.number_field :net_unit_price, step: 0.01, min: 0, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div><%= f.label :tax_rate, "MwSt. %", class: "block text-sm font-medium" %><%= f.number_field :tax_rate, step: 0.01, min: 0, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div><%= f.label :discount_type, "Rabatt", class: "block text-sm font-medium" %><%= f.select :discount_type, [["Keiner", "none"], ["Prozent", "percent"], ["Festbetrag", "fixed"]], {}, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div><%= f.label :discount_value, "Rabattwert", class: "block text-sm font-medium" %><%= f.number_field :discount_value, step: 0.01, min: 0, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div></div><div class="mt-3 grid gap-3 md:grid-cols-2"><div><%= f.label :discount_reason, "Rabattgrund (sichtbar)", class: "block text-sm font-medium" %><%= f.text_field :discount_reason, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div><%= f.label :internal_note, "Interne Notiz", class: "block text-sm font-medium" %><%= f.text_field :internal_note, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div></div><div class="mt-3 flex flex-wrap items-center justify-between gap-3"><p class="text-sm text-slate-600">Netto <strong><%= number_to_currency(line_item.net_total, unit: "€", format: "%n %u") %></strong> · MwSt. <%= number_to_currency(line_item.tax_amount, unit: "€", format: "%n %u") %> · Brutto <strong><%= number_to_currency(line_item.gross_total, unit: "€", format: "%n %u") %></strong></p><div class="flex gap-2"><%= f.submit "Position speichern", class: "admin-cta" if @offer.editable? %><%= button_to "Entfernen", admin_offer_line_item_path(@offer, line_item), method: :delete, class: "rounded-xl border border-rose-300 px-3 py-2 text-sm font-semibold text-rose-700" if @offer.editable? %></div></div></fieldset><% end %><% end %></div><% else %><p class="mt-4 text-sm text-slate-600">Noch keine Positionen. Ergänze Miete, Lieferung, Getränke oder freie Leistungen.</p><% end %></section>
<aside class="rounded-xl bg-[var(--color-zapfe-navy)] p-5 text-white"><h2 class="font-semibold">Kalkulation intern</h2><dl class="mt-4 space-y-3 text-sm"><div class="flex justify-between gap-4"><dt>Zwischensumme netto</dt><dd><%= number_to_currency(@offer.subtotal_net, unit: "€", format: "%n %u") %></dd></div><% if @offer.global_discount_amount.positive? %><div class="flex justify-between gap-4"><dt>Gesamtrabatt</dt><dd>-<%= number_to_currency(@offer.global_discount_amount, unit: "€", format: "%n %u") %></dd></div><% end %><div class="flex justify-between gap-4"><dt>Netto</dt><dd><%= number_to_currency(@offer.net_total, unit: "€", format: "%n %u") %></dd></div><div class="flex justify-between gap-4"><dt>MwSt.</dt><dd><%= number_to_currency(@offer.tax_total, unit: "€", format: "%n %u") %></dd></div><div class="flex justify-between gap-4 border-t border-white/20 pt-3 text-base font-semibold"><dt>Brutto</dt><dd><%= number_to_currency(@offer.gross_total, unit: "€", format: "%n %u") %></dd></div><div class="flex justify-between gap-4 border-t border-white/20 pt-3"><dt>Direkte Kosten</dt><dd><%= number_to_currency(@offer.direct_cost_total, unit: "€", format: "%n %u") %></dd></div><div class="flex justify-between gap-4"><dt>Deckungsbeitrag</dt><dd><%= number_to_currency(@offer.contribution_margin, unit: "€", format: "%n %u") %></dd></div><div class="flex justify-between gap-4"><dt>Marge</dt><dd><%= number_with_precision(@offer.contribution_margin_percent, precision: 1) %> %</dd></div></dl></aside></div>

<% if @offer.editable? %><section class="mt-6 rounded-xl border border-slate-200 bg-white p-5"><h2 class="font-semibold">Position hinzufügen</h2><%= form_with model: [ :admin, @offer, @line_item ], url: admin_offer_line_items_path(@offer), class: "mt-4 space-y-4" do |f| %><div class="grid gap-4 md:grid-cols-2"><div><%= f.label :product_variant_id, "Produktvariante (optional)", class: "block text-sm font-medium" %><%= f.select :product_variant_id, @product_variants.map { |variant| ["#{variant.product.brand} #{variant.product.name} · #{variant.size} l", variant.id] }, { include_blank: "Freie Position" }, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div><%= f.label :supplier_offering_id, "Bezugsquelle (optional, intern)", class: "block text-sm font-medium" %><%= f.select :supplier_offering_id, @supplier_offerings.map { |offering| ["#{offering.supplier.name} · #{offering.product_variant.product.brand} #{offering.product_variant.product.name}", offering.id] }, { include_blank: "Keine Bezugsquelle" }, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div class="md:col-span-2"><%= f.label :description, "Beschreibung (bei Produktvariante optional)", class: "block text-sm font-medium" %><%= f.text_field :description, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div><%= f.label :quantity, "Menge", class: "block text-sm font-medium" %><%= f.number_field :quantity, step: 0.01, min: 0.01, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div><%= f.label :unit, "Einheit", class: "block text-sm font-medium" %><%= f.text_field :unit, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div><%= f.label :net_unit_price, "Netto-Einzelpreis", class: "block text-sm font-medium" %><%= f.number_field :net_unit_price, step: 0.01, min: 0, required: true, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div><%= f.label :tax_rate, "MwSt. %", class: "block text-sm font-medium" %><%= f.number_field :tax_rate, step: 0.01, min: 0, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div></div><%= f.submit "Position hinzufügen", class: "admin-cta" %><% end %></section><% end %>
<section class="mt-6 rounded-xl border border-slate-200 bg-white p-5"><h2 class="font-semibold">Geplante Arbeitszeit <span class="font-normal text-slate-500">(intern)</span></h2><p class="mt-1 text-sm text-slate-600">Der hinterlegte interne Stundensatz fließt als direkte Kosten in die Marge ein.</p><% if @offer.time_entries.where(entry_type: "planned").any? %><ul class="mt-4 space-y-2 text-sm"><% @offer.time_entries.where(entry_type: "planned").each do |entry| %><li class="flex flex-wrap items-center justify-between gap-2 rounded-lg bg-slate-50 px-3 py-2"><span><%= entry.category == "organisation" ? "Organisation" : "Durchführung" %> · <%= entry.minutes %> Min. · <%= number_to_currency(entry.cost_total, unit: "€", format: "%n %u") %><%= " · #{entry.note}" if entry.note.present? %></span><%= button_to "Entfernen", admin_offer_time_entry_path(@offer, entry), method: :delete, class: "text-sm font-semibold text-rose-700" if @offer.editable? %></li><% end %></ul><% end %><% if @offer.editable? %><%= form_with model: [ :admin, @offer, TimeEntry.new ], url: admin_offer_time_entries_path(@offer), class: "mt-4 grid gap-3 md:grid-cols-4" do |f| %><div><%= f.label :category, "Bereich", class: "block text-sm font-medium" %><%= f.select :category, [["Organisation", "organisation"], ["Durchführung", "execution"]], {}, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div><%= f.label :minutes, "Minuten", class: "block text-sm font-medium" %><%= f.number_field :minutes, min: 1, required: true, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div><%= f.label :note, "Interne Notiz", class: "block text-sm font-medium" %><%= f.text_field :note, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div class="self-end"><%= f.submit "Arbeitszeit planen", class: "admin-cta" %></div><% end %><% end %></section>
