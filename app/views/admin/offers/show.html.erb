<%= render "header", offer: @offer %>
<%= render "process", offer: @offer %>

<% unless @offer.editable? %>
  <div class="admin-panel mb-6 border-slate-300 bg-slate-100 text-sm text-slate-700">Dieses Angebot ist finalisiert und unveränderlich. Für Anpassungen bitte eine neue Version erstellen.</div>
<% end %>

<%= render "shared/form_errors", object: @offer %>
<%= render "details_form", offer: @offer %>

<%= render "new_line_item", offer: @offer, line_item: @line_item if @offer.editable? %>

<div class="mt-6 grid gap-5 xl:grid-cols-[minmax(0,1fr)_20rem]">
  <section class="admin-panel">
    <div class="flex flex-wrap items-baseline justify-between gap-2"><div><p class="proof-kicker">Leistungen</p><h2 class="mt-1 text-xl font-semibold text-[var(--color-zapfe-navy)]">Positionen</h2></div><p class="text-sm text-slate-500">Kundenpreise netto · EK nur intern</p></div>
    <% if @offer.line_items.any? %><div class="mt-5 space-y-3"><%= render partial: "line_item", collection: @offer.line_items.order(:position, :created_at), as: :line_item, locals: { offer: @offer } %></div><% else %><div class="admin-empty-state mt-5">Noch keine Positionen. Füge Getränke, Mietpositionen oder freie Leistungen hinzu.</div><% end %>
  </section>
  <%= render "summary", offer: @offer %>
</div>

<%= render "time_entries", offer: @offer %>
