<%= form_with model: [:admin, offer, line_item], url: admin_offer_line_item_path(offer, line_item), method: :patch, class: "rounded-2xl border border-slate-200 p-4" do |f| %>
  <fieldset<%= " disabled" unless offer.editable? %>>
    <div class="grid gap-3 md:grid-cols-6">
      <div class="md:col-span-2"><%= f.label :description, "Beschreibung", class: "block text-sm font-medium" %><%= f.text_field :description, required: true, class: "admin-field" %></div>
      <div><%= f.label :quantity, "Menge", class: "block text-sm font-medium" %><%= f.number_field :quantity, step: 1, min: 1, required: true, class: "admin-field" %></div>
      <div><%= f.label :unit, "Einheit", class: "block text-sm font-medium" %><%= f.text_field :unit, class: "admin-field" %></div>
      <div><%= f.label :net_unit_price, "Netto/Stück", class: "block text-sm font-medium" %><%= f.number_field :net_unit_price, step: 0.01, min: 0, class: "admin-field" %></div>
      <div><%= f.label :tax_rate, "MwSt. %", class: "block text-sm font-medium" %><%= f.number_field :tax_rate, step: 0.01, min: 0, class: "admin-field" %></div>
      <% if line_item.resource.present? %><div class="md:col-span-3"><label class="block text-sm font-medium">Bezugsquelle (intern)</label><p class="admin-readonly-field">Eigene Ressource · <%= line_item.resource.name %></p></div><div class="md:col-span-3 self-end rounded-xl bg-slate-50 px-3 py-2 text-sm text-slate-600">Mietposition · keine externe Beschaffung</div><% elsif line_item.product_variant.present? %><div class="md:col-span-4"><%= f.label :supplier_offering_id, "Bezugsquelle (intern)", class: "block text-sm font-medium" %><%= f.select :supplier_offering_id, (@supplier_offerings_by_variant[line_item.product_variant_id] || []).map { |offering| ["#{offering.supplier.name} · #{number_to_currency(offering.current_price&.purchase_price || 0, unit: "€", format: "%n %u")} · #{offering.lead_time_days} Tage", offering.id] }, { include_blank: "Keine Bezugsquelle" }, class: "admin-field" %></div><div class="md:col-span-2 self-end rounded-xl bg-slate-50 px-3 py-2 text-sm text-slate-600">Direkte Kosten <strong><%= number_to_currency(line_item.direct_cost_unit || 0, unit: "€", format: "%n %u") %></strong></div><% if line_item.supplier_offering&.procurement_overdue?(offer.order.event_date) %><div class="md:col-span-6"><span class="admin-product-badge bg-rose-100 text-rose-800">Vorlauf kritisch</span><span class="ml-2 text-sm text-rose-800">Bestellung hätte bis <%= l(line_item.supplier_offering.order_by_on(offer.order.event_date)) %> erfolgen sollen.</span></div><% end %><% end %>
    </div>
    <details class="mt-3"><summary class="cursor-pointer text-sm font-medium text-slate-600">Rabatt und interne Notiz</summary><div class="mt-3 grid gap-3 md:grid-cols-4"><div><%= f.label :discount_type, "Rabatt", class: "block text-sm font-medium" %><%= f.select :discount_type, [["Keiner", "none"], ["Prozent", "percent"], ["Festbetrag", "fixed"]], {}, class: "admin-field" %></div><div><%= f.label :discount_value, "Rabattwert", class: "block text-sm font-medium" %><%= f.number_field :discount_value, step: 0.01, min: 0, class: "admin-field" %></div><div><%= f.label :discount_reason, "Rabattgrund", class: "block text-sm font-medium" %><%= f.text_field :discount_reason, class: "admin-field" %></div><div><%= f.label :internal_note, "Interne Notiz", class: "block text-sm font-medium" %><%= f.text_field :internal_note, class: "admin-field" %></div></div></details>
    <% margin = line_item.net_total - line_item.direct_cost_total %><% margin_percent = line_item.net_total.zero? ? 0 : margin / line_item.net_total * 100 %><div class="mt-4 flex flex-wrap items-center justify-between gap-3 border-t border-slate-100 pt-3"><p class="text-sm text-slate-600">Netto <strong><%= number_to_currency(line_item.net_total, unit: "€", format: "%n %u") %></strong> · MwSt. <%= number_to_currency(line_item.tax_amount, unit: "€", format: "%n %u") %> · Brutto <strong><%= number_to_currency(line_item.gross_total, unit: "€", format: "%n %u") %></strong> · Marge <strong class="<%= margin.negative? ? "text-rose-700" : "text-emerald-700" %>"><%= number_to_currency(margin, unit: "€", format: "%n %u") %> (<%= number_to_percentage(margin_percent, precision: 1) %>)</strong></p><div class="flex gap-2"><%= f.submit "Speichern", class: "admin-cta" if offer.editable? %><%= link_to "Entfernen", admin_offer_line_item_path(offer, line_item), data: { turbo_method: :delete, turbo_confirm: "Position wirklich entfernen?" }, class: "admin-danger-action" if offer.editable? %></div></div>
  </fieldset>
<% end %>
