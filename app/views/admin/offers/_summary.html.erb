<aside class="rounded-3xl bg-[var(--color-zapfe-navy)] p-5 text-white xl:sticky xl:top-28 xl:self-start"><p class="text-xs font-bold uppercase tracking-[0.15em] text-amber-300">Intern</p><h2 class="mt-1 text-lg font-semibold">Kalkulation</h2><dl class="mt-5 space-y-3 text-sm"><div class="flex justify-between gap-4"><dt>Zwischensumme netto</dt><dd><%= number_to_currency(offer.subtotal_net, unit: "€", format: "%n %u") %></dd></div><% if offer.global_discount_amount.positive? %><div class="flex justify-between gap-4"><dt>Gesamtrabatt</dt><dd>-<%= number_to_currency(offer.global_discount_amount, unit: "€", format: "%n %u") %></dd></div><% end %><div class="flex justify-between gap-4"><dt>Netto</dt><dd><%= number_to_currency(offer.net_total, unit: "€", format: "%n %u") %></dd></div><div class="flex justify-between gap-4"><dt>MwSt.</dt><dd><%= number_to_currency(offer.tax_total, unit: "€", format: "%n %u") %></dd></div><div class="flex justify-between gap-4 border-t border-white/20 pt-3 text-base font-semibold"><dt>Brutto</dt><dd><%= number_to_currency(offer.gross_total, unit: "€", format: "%n %u") %></dd></div></dl><dl class="mt-6 space-y-2 border-t border-white/20 pt-4 text-sm text-slate-200"><div class="flex justify-between gap-4"><dt>Direkte Kosten</dt><dd><%= number_to_currency(offer.direct_cost_total, unit: "€", format: "%n %u") %></dd></div><div class="flex justify-between gap-4"><dt>Deckungsbeitrag</dt><dd><%= number_to_currency(offer.contribution_margin, unit: "€", format: "%n %u") %></dd></div><div class="flex justify-between gap-4"><dt>Marge</dt><dd><%= number_with_precision(offer.contribution_margin_percent, precision: 1) %> %</dd></div></dl></aside>
