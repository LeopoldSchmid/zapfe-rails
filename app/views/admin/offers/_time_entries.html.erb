<section class="admin-panel mt-6"><p class="proof-kicker">Intern</p><h2 class="mt-1 text-lg font-semibold">Geplante Arbeitszeit</h2><p class="mt-1 text-sm text-slate-600">Der interne Stundensatz fließt als direkte Kosten in die Marge ein.</p><% if offer.time_entries.where(entry_type: "planned").any? %><ul class="mt-4 space-y-2"><% offer.time_entries.where(entry_type: "planned").each do |entry| %><li class="flex flex-wrap items-center justify-between gap-3 rounded-xl bg-slate-50 px-3 py-2 text-sm"><span><strong><%= entry.category == "organisation" ? "Organisation" : "Durchführung" %></strong> · <%= entry.minutes %> Min. · <%= number_to_currency(entry.cost_total, unit: "€", format: "%n %u") %><%= " · #{entry.note}" if entry.note.present? %></span><%= button_to "Entfernen", admin_offer_time_entry_path(offer, entry), method: :delete, class: "text-sm font-semibold text-rose-700" if offer.editable? %></li><% end %></ul><% end %><% if offer.editable? %><%= form_with model: [ :admin, offer, TimeEntry.new ], url: admin_offer_time_entries_path(offer), class: "mt-4 grid gap-3 md:grid-cols-4" do |f| %><div><%= f.label :category, "Bereich", class: "block text-sm font-medium" %><%= f.select :category, [["Organisation", "organisation"], ["Durchführung", "execution"]], {}, class: "mt-1 w-full rounded-xl border border-slate-300 px-3 py-2" %></div><div><%= f.label :minutes, "Minuten", class: "block text-sm font-medium" %><%= f.number_field :minutes, min: 1, required: true, class: "mt-1 w-full rounded-xl border border-slate-300 px-3 py-2" %></div><div><%= f.label :note, "Interne Notiz", class: "block text-sm font-medium" %><%= f.text_field :note, class: "mt-1 w-full rounded-xl border border-slate-300 px-3 py-2" %></div><div class="self-end"><%= f.submit "Arbeitszeit planen", class: "admin-cta w-full" %></div><% end %><% end %></section>
