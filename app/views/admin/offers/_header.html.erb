<div class="admin-toolbar">
  <div><p class="proof-kicker">Angebot · <%= { "draft" => "Entwurf", "finalized" => "Finalisiert", "sent" => "Versendet", "accepted" => "Angenommen", "rejected" => "Abgelehnt", "expired" => "Abgelaufen" }.fetch(offer.status) %> · Version <%= offer.version %></p><h1 class="mt-2 text-3xl font-semibold text-[var(--color-zapfe-navy)]"><%= offer.recipient_name %></h1><p class="mt-1 text-sm text-slate-600"><%= offer.offer_number.presence || "Noch keine Angebotsnummer" %> · Auftrag: <%= link_to offer.order.customer_name, admin_order_offers_path(offer.order), class: "underline" %> · gültig bis <%= l(offer.valid_until) %></p></div>
  <div class="flex flex-wrap gap-2"><%= link_to "Zu Angeboten", admin_order_offers_path(offer.order), class: "admin-secondary-action" %><% if offer.editable? %><%= button_to "Angebot finalisieren", finalize_admin_offer_path(offer), method: :post, class: "admin-cta" %><% else %><%= link_to "PDF", document_admin_offer_path(offer), class: "admin-secondary-action" if offer.document.attached? %><%= button_to "Per E-Mail versenden", send_mail_admin_offer_path(offer), method: :post, class: "admin-cta" if offer.status == "finalized" %><% if %w[finalized sent].include?(offer.status) %><%= button_to "Annehmen", resolve_admin_offer_path(offer, status: "accepted"), method: :patch, class: "admin-cta" %><%= button_to "Ablehnen", resolve_admin_offer_path(offer, status: "rejected"), method: :patch, class: "admin-danger-action" %><% end %><%= button_to "Neue Version", duplicate_admin_offer_path(offer), method: :post, class: "admin-cta" %><% end %></div>
</div>
