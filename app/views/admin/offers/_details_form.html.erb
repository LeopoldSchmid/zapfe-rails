<%= form_with model: [ :admin, offer ], class: "admin-panel" do |f| %><fieldset<%= " disabled" unless offer.editable? %>><div class="flex items-baseline justify-between gap-3"><div><p class="proof-kicker">Empfänger</p><h2 class="mt-1 text-lg font-semibold">Angebotsdaten</h2></div><p class="text-xs text-slate-500">Diese Angaben erscheinen im Dokument.</p></div><div class="mt-5 grid gap-4 md:grid-cols-2"><div><%= f.label :recipient_name, "Name oder Firma", class: "block text-sm font-medium" %><%= f.text_field :recipient_name, required: true, class: "mt-1 w-full rounded-xl border border-slate-300 px-3 py-2" %></div><div><%= f.label :recipient_email, "E-Mail", class: "block text-sm font-medium" %><%= f.email_field :recipient_email, class: "mt-1 w-full rounded-xl border border-slate-300 px-3 py-2" %></div><div><%= f.label :valid_until, "Gültig bis", class: "block text-sm font-medium" %><%= f.date_field :valid_until, required: true, class: "mt-1 w-full rounded-xl border border-slate-300 px-3 py-2" %></div></div><div class="mt-4"><%= f.label :recipient_address, "Veranstaltungs-/Empfängeradresse", class: "block text-sm font-medium" %><%= f.text_area :recipient_address, rows: 2, class: "mt-1 w-full rounded-xl border border-slate-300 px-3 py-2" %></div><details class="mt-4 rounded-xl bg-slate-50 p-4"><summary class="cursor-pointer text-sm font-semibold text-slate-700">Rabatt und interne Notiz</summary><div class="mt-4 grid gap-4 md:grid-cols-3"><div><%= f.label :global_discount_type, "Gesamtrabatt", class: "block text-sm font-medium" %><%= f.select :global_discount_type, [["Keiner", "none"], ["Prozent", "percent"], ["Festbetrag", "fixed"]], {}, class: "mt-1 w-full rounded-xl border border-slate-300 px-3 py-2" %></div><div><%= f.label :global_discount_value, "Rabattwert", class: "block text-sm font-medium" %><%= f.number_field :global_discount_value, step: 0.01, min: 0, class: "mt-1 w-full rounded-xl border border-slate-300 px-3 py-2" %></div><div><%= f.label :global_discount_reason, "Rabattgrund (sichtbar)", class: "block text-sm font-medium" %><%= f.text_field :global_discount_reason, class: "mt-1 w-full rounded-xl border border-slate-300 px-3 py-2" %></div></div><div class="mt-4"><%= f.label :internal_note, "Interne Notiz", class: "block text-sm font-medium" %><%= f.text_area :internal_note, rows: 2, class: "mt-1 w-full rounded-xl border border-slate-300 px-3 py-2" %></div></details><%= f.submit "Angebotsdaten speichern", class: "admin-cta mt-5" if offer.editable? %></fieldset><% end %>
