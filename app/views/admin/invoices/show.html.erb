<%= render "admin/orders/workspace_header", order: @invoice.order, section: "Rechnung" %>
<div class="mt-6"><%= render "admin/shared/process_nav", order: @invoice.order, current_phase: "invoice" %></div>

<div class="mt-6 grid gap-6 xl:grid-cols-[minmax(0,1fr)_20rem]">
  <%= form_with model: [:admin, @invoice], class: "admin-panel" do |f| %>
    <fieldset<%= " disabled" unless @invoice.editable? %>>
      <div class="flex flex-wrap items-baseline justify-between gap-3"><div><p class="proof-kicker">Rechnungsentwurf</p><h2 class="mt-1 text-xl font-semibold text-[var(--color-zapfe-navy)]"><%= @invoice.invoice_number.presence || "Noch nicht finalisiert" %></h2></div><span class="admin-product-badge bg-slate-100 text-slate-700"><%= @invoice.status %></span></div>
      <div class="mt-5 grid gap-4 sm:grid-cols-2"><div><%= f.label :recipient_name, "Rechnungsempfänger", class: "admin-field-label" %><%= f.text_field :recipient_name, required: true, class: "admin-field" %></div><div><%= f.label :recipient_email, "E-Mail", class: "admin-field-label" %><%= f.email_field :recipient_email, class: "admin-field" %></div><div class="sm:col-span-2"><%= f.label :recipient_address, "Rechnungsadresse", class: "admin-field-label" %><%= f.text_area :recipient_address, rows: 3, required: true, class: "admin-field" %></div><div><%= f.label :delivery_on, "Liefer-/Leistungsdatum", class: "admin-field-label" %><%= f.date_field :delivery_on, class: "admin-field" %></div><div><%= f.label :due_on, "Zahlbar bis", class: "admin-field-label" %><%= f.date_field :due_on, class: "admin-field" %></div></div>
      <h3 class="mt-7 font-semibold">Positionen aus dem Angebot</h3>
      <div class="mt-3 overflow-x-auto"><table class="w-full min-w-[38rem] text-sm"><thead class="border-b text-left text-slate-500"><tr><th class="pb-2">Beschreibung</th><th class="pb-2 text-right">Menge</th><th class="pb-2 text-right">Netto</th><th class="pb-2 text-right">Gesamt</th></tr></thead><tbody><% @invoice.line_items.order(:position, :created_at).each do |item| %><tr class="border-b border-slate-100"><td class="py-3"><strong><%= item.description %></strong><% if item.discount_reason.present? %><span class="block text-xs text-slate-500">Rabatt: <%= item.discount_reason %></span><% end %></td><td class="py-3 text-right"><%= item.quantity %> <%= item.unit %></td><td class="py-3 text-right"><%= number_to_currency(item.net_unit_price, unit: "€", format: "%n %u") %></td><td class="py-3 text-right"><%= number_to_currency(item.net_total, unit: "€", format: "%n %u") %></td></tr><% end %></tbody></table></div>
      <details class="mt-5 rounded-xl bg-slate-50 p-4"><summary class="cursor-pointer text-sm font-semibold">Gesamtrabatt und interne Notiz</summary><div class="mt-4 grid gap-3 sm:grid-cols-3"><div><%= f.label :global_discount_type, "Rabatt", class: "admin-field-label" %><%= f.select :global_discount_type, [["Keiner", "none"], ["Prozent", "percent"], ["Festbetrag", "fixed"]], {}, class: "admin-field" %></div><div><%= f.label :global_discount_value, "Wert", class: "admin-field-label" %><%= f.number_field :global_discount_value, step: 0.01, min: 0, class: "admin-field" %></div><div><%= f.label :global_discount_reason, "Begründung", class: "admin-field-label" %><%= f.text_field :global_discount_reason, class: "admin-field" %></div></div><div class="mt-3"><%= f.label :internal_note, "Interne Notiz", class: "admin-field-label" %><%= f.text_area :internal_note, rows: 2, class: "admin-field" %></div></details>
      <%= f.submit "Rechnungsentwurf speichern", class: "admin-cta mt-5" if @invoice.editable? %>
    </fieldset>
  <% end %>
  <aside class="admin-panel h-fit"><h2 class="text-lg font-semibold">Summe</h2><dl class="mt-4 space-y-2 text-sm"><div class="flex justify-between"><dt>Netto</dt><dd><%= number_to_currency(@invoice.net_total, unit: "€", format: "%n %u") %></dd></div><div class="flex justify-between"><dt>Mehrwertsteuer</dt><dd><%= number_to_currency(@invoice.tax_total, unit: "€", format: "%n %u") %></dd></div><div class="flex justify-between border-t pt-3 text-base font-semibold"><dt>Brutto</dt><dd><%= number_to_currency(@invoice.gross_total, unit: "€", format: "%n %u") %></dd></div></dl><% if @invoice.paid_at? %><p class="mt-4 rounded-xl bg-emerald-50 px-3 py-2 text-sm font-medium text-emerald-900">Bezahlt am <%= l(@invoice.paid_at, format: :short) %></p><% end %><div class="mt-6 space-y-3"><% if @invoice.editable? %><%= button_to "Rechnung finalisieren", finalize_admin_invoice_path(@invoice), class: "admin-cta w-full", data: { turbo_confirm: "Nach der Finalisierung sind Rechnungsdaten und Positionen unveränderbar. Fortfahren?" } %><% elsif @invoice.document.attached? %><%= link_to "PDF öffnen", document_admin_invoice_path(@invoice), class: "admin-secondary-action block text-center" %><% end %><% if @invoice.status == "finalized" && CustomerDocumentDelivery.enabled? %><%= button_to "Rechnung versenden", send_mail_admin_invoice_path(@invoice), class: "admin-cta w-full", data: { turbo_confirm: "Rechnung wirklich an #{@invoice.recipient_email} versenden?" } %><% elsif @invoice.status == "finalized" %><p class="rounded-xl bg-amber-50 p-3 text-sm text-amber-900">Dokumentversand auf Staging deaktiviert.</p><% end %><% if @invoice.status.in?(%w[finalized sent overdue]) %><%= button_to "Als bezahlt markieren", mark_paid_admin_invoice_path(@invoice), method: :patch, class: "admin-secondary-action w-full" %><% end %><%= link_to "Zur Rechnungsübersicht", admin_order_invoices_path(@invoice.order), class: "admin-link block text-center" %></div></aside>
</div>
