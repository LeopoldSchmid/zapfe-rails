<%= render "shared/form_errors", object: @supplier_offering %>
<%= form_with model: [ :admin, @supplier_offering ], class: "space-y-6" do |f| %><section class="rounded-xl border border-slate-200 bg-white p-5"><h2 class="font-semibold">Händlerangebot</h2><p class="mt-1 text-sm text-slate-600">Eine konkrete Bezugsquelle für genau ein vorhandenes Gebinde.</p><div class="mt-4 grid gap-4 md:grid-cols-2"><div><%= f.label :supplier_id, "Lieferant", class: "block text-sm font-medium" %><%= f.collection_select :supplier_id, @suppliers, :id, :name, { include_blank: "Bitte wählen" }, required: true, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div><%= f.label :procurement_profile_id, "Beschaffungsprofil", class: "block text-sm font-medium" %><%= f.select :procurement_profile_id, @profiles.map { |profile| ["#{profile.supplier.name} · #{profile.name}", profile.id] }, { include_blank: "Bitte wählen" }, required: true, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div class="md:col-span-2"><%= f.label :product_variant_id, "Produktvariante", class: "block text-sm font-medium" %><%= f.select :product_variant_id, @product_variants.map { |variant| ["#{variant.product.brand} #{variant.product.name} · #{variant.size} l", variant.id] }, { include_blank: "Bitte wählen" }, required: true, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div><%= f.label :supplier_sku, "Händler-SKU", class: "block text-sm font-medium" %><%= f.text_field :supplier_sku, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div><%= f.label :lead_time_days_override, "Abweichender Vorlauf (Tage)", class: "block text-sm font-medium" %><%= f.number_field :lead_time_days_override, min: 0, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div><%= f.label :return_policy_override, "Abweichende Rückgabe", class: "block text-sm font-medium" %><%= f.select :return_policy_override, [["Profil verwenden", ""], ["Unbekannt", "unknown"], ["Rückgabefähig", "returnable"], ["Nicht rückgabefähig", "non_returnable"]], {}, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div></div><div class="mt-4"><%= f.label :notes, "Interne Notiz", class: "block text-sm font-medium" %><%= f.text_area :notes, rows: 3, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><label class="mt-4 inline-flex items-center gap-2 text-sm"><%= f.check_box :active %> Angebot aktiv</label></section><section class="rounded-xl border border-slate-200 bg-white p-5"><h2 class="font-semibold">Einkaufspreise</h2><p class="mt-1 text-sm text-slate-600">Neue Preiszeilen behalten ältere Konditionen nachvollziehbar.</p><div class="mt-4 space-y-3"><%= f.fields_for :supplier_prices do |price_form| %><div class="grid gap-3 md:grid-cols-3"><div><%= price_form.label :purchase_price, "Netto-Einkaufspreis", class: "block text-sm font-medium" %><%= price_form.number_field :purchase_price, step: 0.01, min: 0, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div><%= price_form.label :valid_from, "Gültig ab", class: "block text-sm font-medium" %><%= price_form.date_field :valid_from, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div><div><%= price_form.label :valid_until, "Gültig bis", class: "block text-sm font-medium" %><%= price_form.date_field :valid_until, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div></div><% end %></div></section><div class="flex gap-3"><%= f.submit class: "admin-cta" %><%= link_to "Abbrechen", admin_suppliers_path, class: "rounded-xl border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700" %></div><% end %>
